{
  "name": "cursor-browser-cli",
  "displayName": "Cursor Browser CLI",
  "description": "Drive Cursor Browser Tab from CLI / MCP (Grok, Claude Code, Codex)",
  "version": "1.0.0",
  "publisher": "local",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": ["Other"],
  "extensionKind": ["workspace"],
  "activationEvents": ["onStartupFinished"],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      {
        "command": "cursorBrowserCli.status",
        "title": "Cursor Browser CLI: Show Status"
      },
      {
        "command": "cursorBrowserCli.restart",
        "title": "Cursor Browser CLI: Restart Server"
      }
    ],
    "configuration": {
      "title": "Cursor Browser CLI",
      "properties": {
        "cursorBrowserCli.port": {
          "type": "number",
          "default": 17373,
          "description": "Preferred localhost HTTP port (falls through if busy)"
        },
        "cursorBrowserCli.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Start the HTTP bridge on activation"
        }
      }
    }
  }
}
