{
  "name": "cursor-browser-cli",
  "displayName": "Cursor Browser CLI",
  "description": "Drive Cursor's Browser Tab from any CLI or MCP",
  "version": "1.3.1",
  "publisher": "bcharleson",
  "author": {
    "name": "B. Charleson"
  },
  "license": "MIT",
  "icon": "icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/bcharleson/cursor-browser-cli.git"
  },
  "bugs": {
    "url": "https://github.com/bcharleson/cursor-browser-cli/issues"
  },
  "homepage": "https://github.com/bcharleson/cursor-browser-cli#readme",
  "qna": "https://github.com/bcharleson/cursor-browser-cli/issues",
  "galleryBanner": {
    "color": "#141416",
    "theme": "dark"
  },
  "keywords": [
    "cursor",
    "browser",
    "browser-tab",
    "cli",
    "mcp",
    "agent",
    "claude",
    "codex",
    "grok",
    "automation"
  ],
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "extensionKind": [
    "workspace"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onCommand:cursorBrowserCli.restart",
    "onCommand:cursorBrowserCli.status"
  ],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      {
        "command": "cursorBrowserCli.status",
        "title": "Cursor Browser CLI: Show Status"
      },
      {
        "command": "cursorBrowserCli.restart",
        "title": "Cursor Browser CLI: Restart Server"
      }
    ],
    "configuration": {
      "title": "Cursor Browser CLI",
      "properties": {
        "cursorBrowserCli.port": {
          "type": "number",
          "default": 17373,
          "description": "Preferred localhost HTTP port (falls through if busy)"
        },
        "cursorBrowserCli.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Start the HTTP bridge on activation"
        }
      }
    }
  }
}
