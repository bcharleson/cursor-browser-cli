#!/usr/bin/env node
/**
 * cursor-browser — CLI for Cursor Browser CLI
 * Multi-window aware client for the Cursor Browser Tab bridge.
 */
const fs = require("fs");
const os = require("os");
const path = require("path");
const http = require("http");
const { execSync } = require("child_process");

const STATE_DIR = path.join(os.homedir(), ".cursor-browser-cli");
const INSTANCES_FILE = path.join(STATE_DIR, "instances.json");
const PORT_FILE = path.join(STATE_DIR, "port");
const LEGACY_INSTANCES = path.join(
  os.homedir(),
  ".cursor-browser-bridge",
  "instances.json"
);
const LEGACY_PORT = path.join(os.homedir(), ".cursor-browser-bridge", "port");
const DEFAULT_PORT = 17373;

function readInstances() {
  for (const f of [INSTANCES_FILE, LEGACY_INSTANCES]) {
    try {
      if (fs.existsSync(f)) {
        return JSON.parse(fs.readFileSync(f, "utf8") || "{}");
      }
    } catch {
      /* ignore */
    }
  }
  return {};
}

function discoverInstancesFromProcesses() {
  const found = [];
  try {
    const lsof = execSync(
      "lsof -nP -iTCP -sTCP:LISTEN 2>/dev/null | grep -E '127\\.0\\.0\\.1:173[0-9]{2}' || true",
      { encoding: "utf8" }
    );
    for (const line of lsof.split("\n")) {
      if (!line.trim()) continue;
      const parts = line.trim().split(/\s+/);
      const pid = Number(parts[1]);
      const nameField = parts.find((p) => p.includes("127.0.0.1:"));
      if (!pid || !nameField) continue;
      const m = nameField.match(/:(\d+)$/);
      if (!m) continue;
      const port = Number(m[1]);
      let primaryName = null;
      try {
        const ps = execSync(`ps -p ${pid} -o command= 2>/dev/null || true`, {
          encoding: "utf8",
        });
        const mm = ps.match(/extension-host\s+\([^)]+\)\s+([^\s\[]+)/i);
        if (mm) primaryName = mm[1].trim();
      } catch {
        /* ignore */
      }
      found.push({
        id: `discovered-${port}`,
        port,
        pid,
        primaryName,
        primaryPath: primaryName
          ? path.join(os.homedir(), "Developer", primaryName)
          : null,
        workspaceNames: primaryName ? [primaryName] : [],
        workspacePaths: primaryName
          ? [path.join(os.homedir(), "Developer", primaryName)]
          : [],
        basenames: primaryName ? [primaryName] : [],
        discovered: true,
      });
    }
  } catch {
    /* ignore */
  }
  return found;
}

function listInstances() {
  const registered = Object.values(readInstances());
  if (registered.length) {
    return registered.sort((a, b) =>
      String(a.primaryName || "").localeCompare(String(b.primaryName || ""))
    );
  }
  return discoverInstancesFromProcesses().sort((a, b) =>
    String(a.primaryName || "").localeCompare(String(b.primaryName || ""))
  );
}

function scoreInstance(inst, query) {
  if (!query) return 0;
  const q = path.resolve(query);
  const qBase = path.basename(q).toLowerCase();
  const qLower = String(query).toLowerCase();
  let score = 0;
  const paths = inst.workspacePaths || (inst.primaryPath ? [inst.primaryPath] : []);
  const names = inst.workspaceNames || (inst.primaryName ? [inst.primaryName] : []);
  const bases = inst.basenames || paths.map((p) => path.basename(p));
  for (const p of paths) {
    const rp = path.resolve(p);
    if (q === rp) score = Math.max(score, 100);
    else if (q.startsWith(rp + path.sep)) score = Math.max(score, 90);
  }
  for (const b of bases) {
    if (b.toLowerCase() === qBase || b.toLowerCase() === qLower)
      score = Math.max(score, 80);
  }
  for (const n of names) {
    if (n.toLowerCase() === qLower) score = Math.max(score, 85);
  }
  return score;
}

function resolveTarget(opts = {}) {
  if (opts.port || process.env.CURSOR_BROWSER_BRIDGE_PORT || process.env.CURSOR_BROWSER_CLI_PORT) {
    return {
      port: Number(
        opts.port ||
          process.env.CURSOR_BROWSER_CLI_PORT ||
          process.env.CURSOR_BROWSER_BRIDGE_PORT
      ),
      how: "explicit-port",
    };
  }
  const instances = listInstances();
  const query =
    opts.workspace ||
    process.env.CURSOR_BROWSER_WORKSPACE ||
    process.env.CURSOR_BROWSER_PROJECT ||
    null;

  if (!instances.length) {
    for (const f of [PORT_FILE, LEGACY_PORT]) {
      try {
        if (fs.existsSync(f)) {
          const n = Number(fs.readFileSync(f, "utf8").trim());
          if (n > 0) return { port: n, how: "port-file" };
        }
      } catch {
        /* ignore */
      }
    }
    return { port: DEFAULT_PORT, how: "default" };
  }

  if (query) {
    let best = null;
    let bestScore = 0;
    for (const inst of instances) {
      const s = scoreInstance(inst, query);
      if (s > bestScore) {
        bestScore = s;
        best = inst;
      }
    }
    if (best && bestScore >= 50) {
      return { port: best.port, how: "workspace-query", instance: best, score: bestScore };
    }
    throw new Error(
      `No bridge matched workspace "${query}".\n` +
        instances.map((i) => `  :${i.port}  ${i.primaryName || "?"}  ${i.primaryPath || ""}`).join("\n")
    );
  }

  const cwd = process.cwd();
  let best = null;
  let bestScore = 0;
  for (const inst of instances) {
    const s = scoreInstance(inst, cwd);
    if (s > bestScore) {
      bestScore = s;
      best = inst;
    }
  }
  if (best && bestScore >= 70) {
    return { port: best.port, how: "cwd", instance: best, score: bestScore };
  }
  if (instances.length === 1) {
    return { port: instances[0].port, how: "single-instance", instance: instances[0] };
  }
  throw new Error(
    `Multiple Cursor windows; pick one:\n` +
      instances.map((i) => `  :${i.port}  ${i.primaryName || "?"}`).join("\n") +
      `\nUse: cursor-browser --workspace <name> <cmd>`
  );
}

function request(method, pathname, body, port) {
  const payload = body ? JSON.stringify(body) : null;
  return new Promise((resolve, reject) => {
    const req = http.request(
      {
        host: "127.0.0.1",
        port,
        path: pathname,
        method,
        headers: {
          "Content-Type": "application/json",
          ...(payload ? { "Content-Length": Buffer.byteLength(payload) } : {}),
        },
        timeout: 60000,
      },
      (res) => {
        const chunks = [];
        res.on("data", (c) => chunks.push(c));
        res.on("end", () => {
          const raw = Buffer.concat(chunks).toString("utf8");
          let data;
          try {
            data = raw ? JSON.parse(raw) : {};
          } catch {
            data = { ok: false, error: "Non-JSON", raw };
          }
          resolve({ status: res.statusCode, data, port });
        });
      }
    );
    req.on("error", (err) => {
      reject(
        new Error(
          `Cannot reach cursor-browser-cli on 127.0.0.1:${port} (${err.message}).\n` +
            `Fix: cursor-browser setup → Reload Window → cursor-browser windows\n` +
            `Then: cursor-browser --workspace <project> whoami`
        )
      );
    });
    req.on("timeout", () => {
      req.destroy();
      reject(new Error(`Timeout on port ${port}`));
    });
    if (payload) req.write(payload);
    req.end();
  });
}

function saveScreenshot(r, outPath) {
  if (!r || typeof r !== "object") return { path: outPath, bytes: 0 };
  if (r.savedPath && fs.existsSync(r.savedPath)) {
    fs.copyFileSync(r.savedPath, outPath);
    return { path: outPath, bytes: fs.statSync(outPath).size, copiedFrom: r.savedPath };
  }
  if (typeof r.dataUrl === "string" && r.dataUrl.startsWith("data:")) {
    const b64 = r.dataUrl.replace(/^data:image\/\w+;base64,/, "");
    const buf = Buffer.from(b64, "base64");
    fs.mkdirSync(path.dirname(outPath), { recursive: true });
    fs.writeFileSync(outPath, buf);
    return { path: outPath, bytes: buf.length };
  }
  return { path: outPath, bytes: 0, warning: "No image payload" };
}

function extractSnapshotText(data) {
  if (!data || typeof data !== "object") return null;
  // Direct snapshot action: { result: { text, yaml } }
  if (data.result?.text && data.result.yaml !== undefined) {
    return data.result.text;
  }
  // open / nav / interact+--snap: { result: { snapshot: { text, yaml } } }
  if (data.result?.snapshot?.text) {
    return data.result.snapshot.text;
  }
  // Nested under action payload
  if (data.result?.action?.snapshot?.text) {
    return data.result.action.snapshot.text;
  }
  return null;
}

function slimForJson(data) {
  if (!data || typeof data !== "object") return data;
  try {
    const clone = JSON.parse(JSON.stringify(data));
    const dropTree = (snap) => {
      if (snap && typeof snap === "object") delete snap.tree;
    };
    dropTree(clone.result);
    dropTree(clone.result?.snapshot);
    dropTree(clone.result?.action?.snapshot);
    return clone;
  } catch {
    return data;
  }
}

function print(data, { asJson = false } = {}) {
  if (typeof data === "string") {
    process.stdout.write(data.endsWith("\n") ? data : data + "\n");
    return;
  }
  if (!asJson) {
    const snapText = extractSnapshotText(data);
    if (snapText != null) {
      // When open/nav/snap actions also include non-snapshot fields, print snap first
      process.stdout.write(snapText.endsWith("\n") ? snapText : snapText + "\n");
      // If there was a navigation wait or action meta, print a short footer
      const nav = data?.result?.navigation;
      if (nav && typeof nav === "object") {
        process.stdout.write(
          `# navigation: ${nav.ok === false ? "timeout" : "ok"} ${nav.from || ""} → ${nav.url || ""}\n`
        );
      }
      return;
    }
  }
  process.stdout.write(JSON.stringify(slimForJson(data), null, 2) + "\n");
}

function pkgRoot() {
  return path.resolve(__dirname, "..");
}

function runSetup() {
  const setup = path.join(pkgRoot(), "scripts", "setup.js");
  if (!fs.existsSync(setup)) {
    throw new Error(`setup script missing: ${setup}`);
  }
  const mod = require(setup);
  if (typeof mod.main === "function") mod.main();
}

function usage() {
  console.log(`cursor-browser — CLI for Cursor IDE Browser Tab (cursor-browser-cli)

Usage:
  cursor-browser [--workspace <name|path>] [--port N] [--json] [--snap] <command>

Setup:
  setup | install      Install Cursor extension + skills (run after npm i -g)

Routing:
  windows              List Cursor windows with a bridge
  whoami | status      Target window + health

Tabs / nav:
  open <url>           Single-tab open + navigate + snapshot (text)
  nav <url>            Navigate active tab + snapshot (text)
  tabs | close         List / keep one tab
  lock | unlock        Lock tab from human input
  back | forward | reload

Interact (prefer ref from snapshot):
  snap | snapshot
  click <ref|selector> [--snap] [--wait-nav]
  dblclick <ref|selector>
  rightclick <ref|selector>
  type <ref|selector> <text>     # append
  fill <ref|selector> <text>     # clear + set
  select-option <ref|selector> <value|label>
  scroll [ref|selector] [--y N] [--x N] [--top N]
  hover <ref>
  press Enter|Tab|Escape

Flags:
  --workspace NAME     Target Cursor window (multi-project)
  --json               Full JSON (trees stripped)
  --snap               Attach fresh snapshot after interact
  --wait-nav           After click, wait for URL change
  --timeout ms         Wait timeout (default 30000)

Under the hood:
  inspect | console | network | eval <js>
  wait [--url substr] [--text str] [--ref e1] [--selector css]
  resize <W> <H> | screenshot [path.png]

Examples:
  cursor-browser setup
  cursor-browser --workspace my-app open http://localhost:3000
  cursor-browser --workspace my-app click e5 --snap
  cursor-browser --workspace my-app fill e3 "hello"
  cursor-browser --workspace my-app wait --url /dashboard --timeout 15000
`);
}

function parseArgs(argv) {
  const opts = { workspace: null, port: null, rest: [], flags: {} };
  for (let i = 0; i < argv.length; i++) {
    const a = argv[i];
    if (a === "--workspace" || a === "-w" || a === "--project") opts.workspace = argv[++i];
    else if (a === "--port" || a === "-p") opts.port = Number(argv[++i]);
    else if (a.startsWith("--workspace=")) opts.workspace = a.slice(12);
    else if (a === "--interactive") opts.flags.interactive = true;
    else if (a === "--json") opts.flags.json = true;
    else if (a === "--snap" || a === "--snapshot") opts.flags.snap = true;
    else if (a === "--wait-nav" || a === "--wait-navigation") opts.flags.waitNav = true;
    else if (a === "--url") opts.flags.urlContains = argv[++i];
    else if (a === "--text") opts.flags.text = argv[++i];
    else if (a === "--ref") opts.flags.ref = argv[++i];
    else if (a === "--selector") opts.flags.selector = argv[++i];
    else if (a === "--timeout") opts.flags.timeoutMs = Number(argv[++i]);
    else if (a === "--y" || a === "--delta-y") opts.flags.y = Number(argv[++i]);
    else if (a === "--x" || a === "--delta-x") opts.flags.x = Number(argv[++i]);
    else if (a === "--top") opts.flags.top = Number(argv[++i]);
    else if (a === "--left") opts.flags.left = Number(argv[++i]);
    else if (a === "--value") opts.flags.value = argv[++i];
    else if (a === "--label") opts.flags.label = argv[++i];
    else if (a === "--index") opts.flags.index = Number(argv[++i]);
    else if (a === "-h" || a === "--help") opts.help = true;
    else opts.rest.push(a);
  }
  return opts;
}

function interactExtras(flags) {
  const extra = {};
  if (flags.snap) {
    extra.snapshot = true;
    extra.includeSnapshot = true;
  }
  if (flags.waitNav) {
    extra.waitNavigation = true;
    if (flags.timeoutMs) extra.timeoutMs = flags.timeoutMs;
  }
  return extra;
}

function looksLikeRef(s) {
  return /^e\d+$/i.test(s) || s === "root";
}

async function main() {
  const opts = parseArgs(process.argv.slice(2));
  if (opts.help || !opts.rest.length) {
    usage();
    process.exit(opts.help ? 0 : 1);
  }
  const [cmd, ...rest] = opts.rest;

  if (cmd === "setup" || cmd === "install") {
    try {
      runSetup();
    } catch (err) {
      console.error(err.message || err);
      process.exit(1);
    }
    return;
  }

  if (cmd === "windows" || cmd === "list") {
    const instances = listInstances();
    const enriched = [];
    for (const inst of instances) {
      try {
        const r = await request("GET", "/whoami", null, inst.port);
        enriched.push({
          port: inst.port,
          primaryName: r.data.workspace?.primaryName || inst.primaryName,
          primaryPath: r.data.workspace?.primaryPath || inst.primaryPath,
          version: r.data.version,
          live: true,
        });
      } catch {
        enriched.push({
          port: inst.port,
          primaryName: inst.primaryName,
          live: false,
        });
      }
    }
    print({ ok: true, instances: enriched, cwd: process.cwd() });
    return;
  }

  let target;
  try {
    target = resolveTarget(opts);
  } catch (err) {
    console.error(err.message || err);
    process.exit(1);
  }
  const port = target.port;
  const action = (body) => request("POST", "/action", body, port);
  const get = (p) => request("GET", p, null, port);
  const extra = interactExtras(opts.flags);
  const asJson = !!opts.flags.json;

  try {
    let res;
    switch (cmd) {
      case "status":
      case "health":
        res = await get("/status");
        break;
      case "whoami":
        res = await get("/whoami");
        res.data = {
          ...res.data,
          routing: { how: target.how, score: target.score, cwd: process.cwd() },
        };
        break;
      case "probe":
        res = await get("/probe");
        break;
      case "open":
        if (!rest[0]) throw new Error("url required");
        res = await action({
          action: "open",
          url: rest[0],
          interactive: true,
        });
        break;
      case "nav":
      case "navigate":
        if (!rest[0]) throw new Error("url required");
        res = await action({
          action: "navigate",
          url: rest[0],
          interactive: true,
        });
        break;
      case "tabs":
        res = await action({ action: "tabs" });
        break;
      case "close":
        res = await action({ action: "close", viewId: rest[0] });
        break;
      case "lock":
        res = await action({ action: "lock" });
        break;
      case "unlock":
        res = await action({ action: "unlock" });
        break;
      case "snap":
      case "snapshot":
      case "refs":
        res = await action({
          action: "snapshot",
          interactive: opts.flags.interactive !== false,
        });
        break;
      case "click":
      case "dblclick":
      case "doubleclick":
      case "double-click":
      case "rightclick":
      case "right-click":
      case "contextmenu": {
        if (!rest[0]) throw new Error("ref or selector required");
        const targetEl = rest[0];
        const kind =
          cmd === "click"
            ? "click"
            : cmd.startsWith("dbl") || cmd.startsWith("double")
              ? "dblclick"
              : "rightclick";
        res = await action(
          looksLikeRef(targetEl)
            ? { action: kind, ref: targetEl, ...extra }
            : { action: kind, selector: rest.join(" "), ...extra }
        );
        break;
      }
      case "type":
      case "fill": {
        if (rest.length < 2) throw new Error(`${cmd} <ref|selector> <text>`);
        const t = rest[0];
        const value = rest.slice(1).join(" ");
        res = await action(
          looksLikeRef(t)
            ? { action: cmd, ref: t, text: value, value, ...extra }
            : { action: cmd, selector: t, text: value, value, ...extra }
        );
        break;
      }
      case "select-option":
      case "select_option":
      case "option": {
        if (!rest[0]) throw new Error("select-option <ref|selector> <value|label>");
        const t = rest[0];
        const choice = rest.slice(1).join(" ") || opts.flags.value || opts.flags.label;
        const payload = {
          action: "select-option",
          ...(looksLikeRef(t) ? { ref: t } : { selector: t }),
          ...extra,
        };
        if (opts.flags.value != null) payload.value = opts.flags.value;
        else if (opts.flags.label != null) payload.label = opts.flags.label;
        else if (opts.flags.index != null) payload.index = opts.flags.index;
        else if (choice) {
          payload.value = choice;
          payload.label = choice;
        } else {
          throw new Error("select-option needs value, --label, or --index");
        }
        res = await action(payload);
        break;
      }
      case "scroll": {
        const t = rest[0];
        const payload = {
          action: "scroll",
          x: opts.flags.x || 0,
          y: opts.flags.y != null ? opts.flags.y : rest[1] != null ? Number(rest[1]) : undefined,
          top: opts.flags.top,
          left: opts.flags.left,
          ...extra,
        };
        if (t && looksLikeRef(t)) payload.ref = t;
        else if (t) payload.selector = t;
        res = await action(payload);
        break;
      }
      case "hover":
        if (!rest[0]) throw new Error("ref required");
        res = await action({ action: "hover", ref: rest[0], ...extra });
        break;
      case "press":
        if (!rest[0]) throw new Error("key required");
        res = await action({ action: "press", key: rest[0], ...extra });
        break;
      case "wait":
      case "wait-for":
        res = await action({
          action: "wait",
          urlContains: opts.flags.urlContains,
          text: opts.flags.text,
          ref: opts.flags.ref,
          selector: opts.flags.selector || rest[0],
          timeoutMs: opts.flags.timeoutMs || 30000,
        });
        break;
      case "resize":
        if (rest.length < 2) throw new Error("resize <width> <height>");
        res = await action({
          action: "resize",
          width: Number(rest[0]),
          height: Number(rest[1]),
        });
        break;
      case "url":
        res = await action({ action: "url" });
        break;
      case "title":
        res = await action({ action: "title" });
        break;
      case "inspect":
      case "dom":
        res = await action({ action: "inspect" });
        break;
      case "console":
      case "logs":
        res = await action({ action: "console" });
        break;
      case "network":
        res = await action({ action: "network" });
        break;
      case "eval":
      case "evaluate":
        if (!rest[0]) throw new Error("js required");
        res = await action({ action: "evaluate", script: rest.join(" ") });
        break;
      case "screenshot": {
        const outPath = rest[0] || path.join(os.tmpdir(), "cursor-browser.png");
        res = await action({ action: "screenshot", path: outPath });
        if (res.data?.ok !== false) {
          const r = res.data.result || res.data;
          const saved = saveScreenshot(r, outPath);
          if (res.data.result && typeof res.data.result === "object") {
            const slim = { ...res.data.result };
            delete slim.dataUrl;
            delete slim.data;
            res.data.result = slim;
          }
          res.data.savedTo = saved.path;
          res.data.bytes = saved.bytes;
        }
        break;
      }
      case "back":
        res = await action({ action: "back" });
        break;
      case "forward":
        res = await action({ action: "forward" });
        break;
      case "reload":
        res = await action({ action: "reload" });
        break;
      case "select":
      case "select-tab":
        if (!rest[0]) throw new Error("viewId required");
        res = await action({ action: "selectTab", viewId: rest[0] });
        break;
      default:
        usage();
        process.exit(1);
    }

    // If --snap was requested but post-action snapshot failed (common after navigation),
    // take a separate snapshot so agents still get fresh refs.
    if (
      opts.flags.snap &&
      res?.data?.ok !== false &&
      !extractSnapshotText(res.data) &&
      !["open", "nav", "navigate", "snap", "snapshot", "refs"].includes(cmd)
    ) {
      try {
        const snapRes = await action({
          action: "snapshot",
          interactive: true,
        });
        if (snapRes.data?.ok !== false && extractSnapshotText(snapRes.data)) {
          const base =
            res.data?.result && typeof res.data.result === "object"
              ? res.data.result
              : { action: res.data?.result };
          res.data = {
            ok: true,
            result: {
              ...base,
              snapshot: snapRes.data.result,
              snapshotVia: "cli-fallback",
            },
            _cli: res.data?._cli,
          };
        }
      } catch {
        /* keep original result */
      }
    }

    if (res.data && typeof res.data === "object") {
      res.data._cli = {
        port,
        how: target.how,
        workspace: target.instance?.primaryName || res.data.workspace?.primaryName,
      };
    }
    print(res.data !== undefined ? res.data : res, { asJson });
    if (res.data && res.data.ok === false) process.exit(2);
  } catch (err) {
    console.error(err.message || err);
    process.exit(1);
  }
}

main();
