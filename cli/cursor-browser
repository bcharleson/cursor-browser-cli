#!/usr/bin/env node
/**
 * cursor-browser — CLI client for Cursor Browser Bridge
 *
 * Multi-window aware: routes to the bridge instance whose workspace
 * matches cwd (or --workspace / CURSOR_BROWSER_WORKSPACE).
 */
const fs = require("fs");
const os = require("os");
const path = require("path");
const http = require("http");

const STATE_DIR = path.join(os.homedir(), ".cursor-browser-bridge");
const INSTANCES_FILE = path.join(STATE_DIR, "instances.json");
const PORT_FILE = path.join(STATE_DIR, "port");
const DEFAULT_PORT = 17373;

function readInstances() {
  try {
    if (!fs.existsSync(INSTANCES_FILE)) return {};
    return JSON.parse(fs.readFileSync(INSTANCES_FILE, "utf8") || "{}");
  } catch {
    return {};
  }
}

function listInstances() {
  const map = readInstances();
  return Object.values(map).sort((a, b) =>
    String(a.primaryName || "").localeCompare(String(b.primaryName || ""))
  );
}

function isAlive(inst) {
  if (!inst || !inst.port) return false;
  if (inst.pid) {
    try {
      process.kill(inst.pid, 0);
    } catch {
      // pid dead — still try HTTP; extension host pid may differ from registered
    }
  }
  return true;
}

/**
 * Score how well an instance matches a query path or name.
 */
function scoreInstance(inst, query) {
  if (!query) return 0;
  const q = path.resolve(query);
  const qBase = path.basename(q).toLowerCase();
  const qLower = query.toLowerCase();
  let score = 0;

  const paths = inst.workspacePaths || (inst.primaryPath ? [inst.primaryPath] : []);
  const names = inst.workspaceNames || (inst.primaryName ? [inst.primaryName] : []);
  const bases = inst.basenames || paths.map((p) => path.basename(p));

  for (const p of paths) {
    const rp = path.resolve(p);
    if (q === rp) score = Math.max(score, 100);
    else if (q.startsWith(rp + path.sep)) score = Math.max(score, 90);
    else if (rp.startsWith(q + path.sep)) score = Math.max(score, 70);
  }
  for (const b of bases) {
    if (b.toLowerCase() === qBase || b.toLowerCase() === qLower) score = Math.max(score, 80);
    else if (b.toLowerCase().includes(qLower) || qLower.includes(b.toLowerCase()))
      score = Math.max(score, 50);
  }
  for (const n of names) {
    if (n.toLowerCase() === qLower) score = Math.max(score, 85);
    else if (n.toLowerCase().includes(qLower)) score = Math.max(score, 55);
  }
  return score;
}

/**
 * Resolve which bridge port to use.
 * Priority:
 *  1. --port / CURSOR_BROWSER_BRIDGE_PORT
 *  2. --workspace / CURSOR_BROWSER_WORKSPACE (name or path)
 *  3. Match process.cwd() against registered workspaces
 *  4. Single instance only
 *  5. Fail with helpful list
 */
function resolveTarget(opts = {}) {
  if (opts.port || process.env.CURSOR_BROWSER_BRIDGE_PORT) {
    return {
      port: Number(opts.port || process.env.CURSOR_BROWSER_BRIDGE_PORT),
      how: "explicit-port",
    };
  }

  const instances = listInstances().filter(isAlive);
  const query =
    opts.workspace ||
    process.env.CURSOR_BROWSER_WORKSPACE ||
    process.env.CURSOR_BROWSER_PROJECT ||
    null;

  if (instances.length === 0) {
    // legacy single port file
    try {
      if (fs.existsSync(PORT_FILE)) {
        const n = Number(fs.readFileSync(PORT_FILE, "utf8").trim());
        if (n > 0) return { port: n, how: "legacy-port-file" };
      }
    } catch {
      /* ignore */
    }
    return { port: DEFAULT_PORT, how: "default", warning: "no instances registered" };
  }

  if (query) {
    let best = null;
    let bestScore = 0;
    for (const inst of instances) {
      const s = scoreInstance(inst, query);
      if (s > bestScore) {
        bestScore = s;
        best = inst;
      }
    }
    if (best && bestScore >= 50) {
      return {
        port: best.port,
        how: "workspace-query",
        instance: best,
        score: bestScore,
      };
    }
    const err = new Error(
      `No bridge instance matched workspace "${query}".\n` +
        formatInstances(instances) +
        `\nTip: cursor-browser --workspace af-exec-travel status`
    );
    err.code = "NO_MATCH";
    throw err;
  }

  // Match cwd
  const cwd = process.cwd();
  let best = null;
  let bestScore = 0;
  for (const inst of instances) {
    const s = scoreInstance(inst, cwd);
    if (s > bestScore) {
      bestScore = s;
      best = inst;
    }
  }
  if (best && bestScore >= 70) {
    return {
      port: best.port,
      how: "cwd",
      instance: best,
      score: bestScore,
    };
  }

  if (instances.length === 1) {
    return {
      port: instances[0].port,
      how: "single-instance",
      instance: instances[0],
    };
  }

  // Ambiguous
  const err = new Error(
    `Multiple Cursor windows have Browser Bridge running; cannot pick from cwd (${cwd}).\n` +
      formatInstances(instances) +
      `\nUse: cursor-browser --workspace <name-or-path> <cmd>\n` +
      `  or: cd into the project folder first\n` +
      `  or: CURSOR_BROWSER_WORKSPACE=af-exec-travel cursor-browser ...`
  );
  err.code = "AMBIGUOUS";
  throw err;
}

function formatInstances(instances) {
  if (!instances.length) return "  (none)";
  return instances
    .map(
      (i) =>
        `  :${i.port}  ${(i.primaryName || "?").padEnd(20)}  ${i.primaryPath || ""}${
          i.tabsHint ? "" : ""
        }`
    )
    .join("\n");
}

function request(method, pathname, body, port) {
  const payload = body ? JSON.stringify(body) : null;
  return new Promise((resolve, reject) => {
    const req = http.request(
      {
        host: "127.0.0.1",
        port,
        path: pathname,
        method,
        headers: {
          "Content-Type": "application/json",
          ...(payload ? { "Content-Length": Buffer.byteLength(payload) } : {}),
        },
        timeout: 30000,
      },
      (res) => {
        const chunks = [];
        res.on("data", (c) => chunks.push(c));
        res.on("end", () => {
          const raw = Buffer.concat(chunks).toString("utf8");
          let data;
          try {
            data = raw ? JSON.parse(raw) : {};
          } catch {
            data = { ok: false, error: "Non-JSON response", raw };
          }
          resolve({ status: res.statusCode, data, port });
        });
      }
    );
    req.on("error", (err) => {
      reject(
        new Error(
          `Cannot reach Cursor Browser Bridge on 127.0.0.1:${port} (${err.message}).\n` +
            `Is Cursor open with cursor-browser-bridge installed in that window?`
        )
      );
    });
    req.on("timeout", () => {
      req.destroy();
      reject(new Error(`Timeout talking to bridge on port ${port}`));
    });
    if (payload) req.write(payload);
    req.end();
  });
}

function saveScreenshot(r, outPath) {
  if (!r || typeof r !== "object") {
    return { path: outPath, bytes: 0 };
  }
  if (r.savedPath && fs.existsSync(r.savedPath)) {
    fs.copyFileSync(r.savedPath, outPath);
    const st = fs.statSync(outPath);
    return { path: outPath, bytes: st.size, copiedFrom: r.savedPath };
  }
  if (typeof r.dataUrl === "string" && r.dataUrl.startsWith("data:")) {
    const b64 = r.dataUrl.replace(/^data:image\/\w+;base64,/, "");
    const buf = Buffer.from(b64, "base64");
    fs.mkdirSync(path.dirname(outPath), { recursive: true });
    fs.writeFileSync(outPath, buf);
    return { path: outPath, bytes: buf.length };
  }
  if (typeof r.data === "string") {
    const buf = Buffer.from(
      r.data,
      r.encoding === "base64" || !r.encoding ? "base64" : r.encoding
    );
    fs.mkdirSync(path.dirname(outPath), { recursive: true });
    fs.writeFileSync(outPath, buf);
    return { path: outPath, bytes: buf.length };
  }
  return { path: outPath, bytes: 0, warning: "No image payload to save" };
}

function print(data) {
  if (typeof data === "string") {
    process.stdout.write(data + (data.endsWith("\n") ? "" : "\n"));
    return;
  }
  process.stdout.write(JSON.stringify(data, null, 2) + "\n");
}

function usage() {
  console.log(`cursor-browser — drive Cursor's Browser Tab (per project window)

Usage:
  cursor-browser [--workspace <name|path>] [--port N] <command>

Commands:
  windows | list          List bridge instances (one per Cursor window)
  status                  Health + workspace for the resolved window
  whoami                  Which window this CLI would hit
  probe
  open <url>              Open Browser Tab IN THAT window + navigate
  nav|navigate <url>
  tabs | url | title
  snap [path.png]
  eval <js>
  back | forward | reload
  select <viewId>
  cdp <Method> [json]

Routing (important with multiple Cursor windows):
  1. --port N / CURSOR_BROWSER_BRIDGE_PORT
  2. --workspace af-exec-travel  (or full path)
  3. Match process cwd to a registered workspace folder
  4. Only one window open → use it

Examples:
  cd ~/Developer/af-exec-travel && cursor-browser open http://localhost:3000
  cursor-browser --workspace af-exec-travel open http://localhost:3000
  cursor-browser windows
`);
}

function parseArgs(argv) {
  const opts = { workspace: null, port: null, rest: [] };
  for (let i = 0; i < argv.length; i++) {
    const a = argv[i];
    if (a === "--workspace" || a === "-w" || a === "--project") {
      opts.workspace = argv[++i];
    } else if (a === "--port" || a === "-p") {
      opts.port = Number(argv[++i]);
    } else if (a.startsWith("--workspace=")) {
      opts.workspace = a.slice("--workspace=".length);
    } else if (a.startsWith("--port=")) {
      opts.port = Number(a.slice("--port=".length));
    } else if (a === "-h" || a === "--help") {
      opts.help = true;
    } else {
      opts.rest.push(a);
    }
  }
  return opts;
}

async function main() {
  const opts = parseArgs(process.argv.slice(2));
  if (opts.help || opts.rest.length === 0) {
    usage();
    process.exit(opts.help ? 0 : 1);
  }

  const [cmd, ...rest] = opts.rest;

  // windows/list does not need a target
  if (cmd === "windows" || cmd === "list" || cmd === "instances") {
    const instances = listInstances();
    if (!instances.length) {
      print({ ok: true, instances: [], note: "No bridges registered. Reload Cursor windows." });
      return;
    }
    // Enrich with live status when possible
    const enriched = [];
    for (const inst of instances) {
      try {
        const r = await request("GET", "/whoami", null, inst.port);
        enriched.push({
          port: inst.port,
          primaryName: r.data.workspace?.primaryName || inst.primaryName,
          primaryPath: r.data.workspace?.primaryPath || inst.primaryPath,
          instanceId: r.data.instanceId || inst.id,
          live: true,
        });
      } catch {
        enriched.push({
          port: inst.port,
          primaryName: inst.primaryName,
          primaryPath: inst.primaryPath,
          live: false,
        });
      }
    }
    print({ ok: true, instances: enriched, cwd: process.cwd() });
    return;
  }

  let target;
  try {
    target = resolveTarget(opts);
  } catch (err) {
    console.error(err.message || err);
    process.exit(1);
  }

  const port = target.port;
  const action = (body) => request("POST", "/action", body, port);
  const get = (pathname) => request("GET", pathname, null, port);

  try {
    let res;
    switch (cmd) {
      case "status":
      case "health":
        res = await get("/status");
        break;
      case "whoami":
        res = await get("/whoami");
        res.data = {
          ...res.data,
          routing: { how: target.how, score: target.score, cwd: process.cwd() },
        };
        break;
      case "probe":
        res = await get("/probe");
        break;
      case "open":
        if (!rest[0]) throw new Error("url required");
        res = await action({ action: "open", url: rest[0] });
        break;
      case "nav":
      case "navigate":
        if (!rest[0]) throw new Error("url required");
        res = await action({ action: "navigate", url: rest[0] });
        break;
      case "tabs":
        res = await action({ action: "tabs" });
        break;
      case "url":
        res = await action({ action: "url" });
        break;
      case "title":
        res = await action({ action: "title" });
        break;
      case "snap":
      case "screenshot": {
        const outPath = rest[0] || path.join(os.tmpdir(), "cursor-browser-snap.png");
        res = await action({ action: "screenshot", path: outPath });
        if (res.data && res.data.ok !== false) {
          const r = res.data.result || res.data;
          const saved = saveScreenshot(r, outPath);
          if (res.data.result && typeof res.data.result === "object") {
            const slim = { ...res.data.result };
            delete slim.dataUrl;
            delete slim.data;
            res.data.result = slim;
          }
          res.data.savedTo = saved.path;
          res.data.bytes = saved.bytes;
          if (saved.copiedFrom) res.data.copiedFrom = saved.copiedFrom;
          if (saved.warning) res.data.warning = saved.warning;
        }
        break;
      }
      case "eval":
      case "evaluate":
        if (!rest[0]) throw new Error("js expression/script required");
        res = await action({ action: "evaluate", script: rest.join(" ") });
        break;
      case "back":
        res = await action({ action: "back" });
        break;
      case "forward":
        res = await action({ action: "forward" });
        break;
      case "reload":
        res = await action({ action: "reload" });
        break;
      case "select":
        if (!rest[0]) throw new Error("viewId required");
        res = await action({ action: "select", viewId: rest[0] });
        break;
      case "cdp": {
        if (!rest[0]) throw new Error("CDP method required");
        const method = rest[0];
        let params = {};
        if (rest[1]) params = JSON.parse(rest.slice(1).join(" "));
        res = await action({ action: "cdp", method, params });
        break;
      }
      default:
        usage();
        process.exit(1);
    }

    // Annotate with routing for clarity
    if (res.data && typeof res.data === "object") {
      res.data._bridge = {
        port,
        how: target.how,
        workspace:
          target.instance?.primaryName ||
          res.data.workspace?.primaryName ||
          null,
      };
    }
    print(res.data !== undefined ? res.data : res);
    if (res.data && res.data.ok === false) process.exit(2);
  } catch (err) {
    console.error(err.message || err);
    process.exit(1);
  }
}

main();
