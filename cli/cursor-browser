#!/usr/bin/env node
/**
 * cursor-browser — CLI for Cursor Browser CLI
 * Multi-window aware client for the Cursor Browser Tab bridge.
 */
const fs = require("fs");
const os = require("os");
const path = require("path");
const http = require("http");
const { execSync } = require("child_process");

const STATE_DIR = path.join(os.homedir(), ".cursor-browser-cli");
const INSTANCES_FILE = path.join(STATE_DIR, "instances.json");
const PORT_FILE = path.join(STATE_DIR, "port");
const LEGACY_INSTANCES = path.join(
  os.homedir(),
  ".cursor-browser-bridge",
  "instances.json"
);
const LEGACY_PORT = path.join(os.homedir(), ".cursor-browser-bridge", "port");
const DEFAULT_PORT = 17373;
const REQUEST_RESTART_FILE = path.join(STATE_DIR, "request-restart");
const REQUEST_RELOAD_FILE = path.join(STATE_DIR, "request-reload");

function readInstances() {
  for (const f of [INSTANCES_FILE, LEGACY_INSTANCES]) {
    try {
      if (fs.existsSync(f)) {
        return JSON.parse(fs.readFileSync(f, "utf8") || "{}");
      }
    } catch {
      /* ignore */
    }
  }
  return {};
}

function discoverInstancesFromProcesses() {
  const found = [];
  try {
    const lsof = execSync(
      "lsof -nP -iTCP -sTCP:LISTEN 2>/dev/null | grep -E '127\\.0\\.0\\.1:173[0-9]{2}' || true",
      { encoding: "utf8" }
    );
    for (const line of lsof.split("\n")) {
      if (!line.trim()) continue;
      const parts = line.trim().split(/\s+/);
      const pid = Number(parts[1]);
      const nameField = parts.find((p) => p.includes("127.0.0.1:"));
      if (!pid || !nameField) continue;
      const m = nameField.match(/:(\d+)$/);
      if (!m) continue;
      const port = Number(m[1]);
      let primaryName = null;
      try {
        const ps = execSync(`ps -p ${pid} -o command= 2>/dev/null || true`, {
          encoding: "utf8",
        });
        const mm = ps.match(/extension-host\s+\([^)]+\)\s+([^\s\[]+)/i);
        if (mm) primaryName = mm[1].trim();
      } catch {
        /* ignore */
      }
      found.push({
        id: `discovered-${port}`,
        port,
        pid,
        primaryName,
        primaryPath: primaryName
          ? path.join(os.homedir(), "Developer", primaryName)
          : null,
        workspaceNames: primaryName ? [primaryName] : [],
        workspacePaths: primaryName
          ? [path.join(os.homedir(), "Developer", primaryName)]
          : [],
        basenames: primaryName ? [primaryName] : [],
        discovered: true,
      });
    }
  } catch {
    /* ignore */
  }
  return found;
}

function portIsAlive(port) {
  try {
    // Fast TCP connect (does not require curl). Bridge answers on 1737x when up.
    execSync(
      `node -e "const n=require('net');const s=n.connect(${Number(port)},'127.0.0.1',()=>{s.end();process.exit(0)});s.on('error',()=>process.exit(1));setTimeout(()=>process.exit(1),400);"`,
      { stdio: "ignore" }
    );
    return true;
  } catch {
    return false;
  }
}

function pruneStaleRegistry() {
  const map = readInstances();
  let changed = false;
  for (const [id, inst] of Object.entries(map)) {
    const port = Number(inst.port);
    if (!port || !portIsAlive(port)) {
      delete map[id];
      changed = true;
    }
  }
  if (changed) {
    try {
      fs.mkdirSync(STATE_DIR, { recursive: true });
      fs.writeFileSync(INSTANCES_FILE, JSON.stringify(map, null, 2));
    } catch {
      /* ignore */
    }
  }
  return map;
}

function listInstances() {
  const map = pruneStaleRegistry();
  const byPort = new Map();
  for (const inst of Object.values(map)) {
    if (inst.port) byPort.set(Number(inst.port), inst);
  }
  for (const inst of discoverInstancesFromProcesses()) {
    if (!byPort.has(Number(inst.port))) byPort.set(Number(inst.port), inst);
  }
  return Array.from(byPort.values()).sort((a, b) =>
    String(a.primaryName || "").localeCompare(String(b.primaryName || ""))
  );
}

function scoreInstance(inst, query) {
  if (!query) return 0;
  const q = path.resolve(query);
  const qBase = path.basename(q).toLowerCase();
  const qLower = String(query).toLowerCase();
  let score = 0;
  const paths = inst.workspacePaths || (inst.primaryPath ? [inst.primaryPath] : []);
  const names = inst.workspaceNames || (inst.primaryName ? [inst.primaryName] : []);
  const bases = inst.basenames || paths.map((p) => path.basename(p));
  for (const p of paths) {
    const rp = path.resolve(p);
    if (q === rp) score = Math.max(score, 100);
    else if (q.startsWith(rp + path.sep)) score = Math.max(score, 90);
  }
  for (const b of bases) {
    if (b.toLowerCase() === qBase || b.toLowerCase() === qLower)
      score = Math.max(score, 80);
  }
  for (const n of names) {
    if (n.toLowerCase() === qLower) score = Math.max(score, 85);
  }
  return score;
}

function formatWindowsHint(instances) {
  return (
    instances
      .map((i) => `  :${i.port}  ${i.primaryName || "?"}  ${i.primaryPath || ""}`)
      .join("\n") +
    `\nDiscover: cursor-browser windows\nPin:      cursor-browser pin\nUse:      cursor-browser --workspace <name> <cmd>`
  );
}

/**
 * Resolve which Cursor window/bridge to talk to.
 * Order: explicit port → --workspace / env → cwd match → single instance.
 * Never silently picks another project when multiple bridges are live.
 */
function resolveTarget(opts = {}) {
  if (opts.port || process.env.CURSOR_BROWSER_BRIDGE_PORT || process.env.CURSOR_BROWSER_CLI_PORT) {
    const port = Number(
      opts.port ||
        process.env.CURSOR_BROWSER_CLI_PORT ||
        process.env.CURSOR_BROWSER_BRIDGE_PORT
    );
    const instances = listInstances();
    const instance = instances.find((i) => Number(i.port) === port) || null;
    return {
      port,
      how: "explicit-port",
      instance,
      workspace: instance?.primaryName || null,
    };
  }
  const instances = listInstances();
  const query =
    opts.workspace ||
    process.env.CURSOR_BROWSER_WORKSPACE ||
    process.env.CURSOR_BROWSER_PROJECT ||
    null;

  if (!instances.length) {
    // Only use shared port-file when no registry — never as multi-project fallback.
    for (const f of [PORT_FILE, LEGACY_PORT]) {
      try {
        if (fs.existsSync(f)) {
          const n = Number(fs.readFileSync(f, "utf8").trim());
          if (n > 0 && portIsAlive(n)) return { port: n, how: "port-file", instance: null };
        }
      } catch {
        /* ignore */
      }
    }
    return { port: DEFAULT_PORT, how: "default-no-bridge", instance: null };
  }

  if (query) {
    let best = null;
    let bestScore = 0;
    for (const inst of instances) {
      const s = scoreInstance(inst, query);
      if (s > bestScore) {
        bestScore = s;
        best = inst;
      }
    }
    if (best && bestScore >= 50) {
      return {
        port: best.port,
        how: "workspace-query",
        instance: best,
        score: bestScore,
        workspace: best.primaryName || null,
      };
    }
    throw new Error(
      `No bridge matched workspace "${query}".\n` + formatWindowsHint(instances)
    );
  }

  const cwd = process.cwd();
  let best = null;
  let bestScore = 0;
  for (const inst of instances) {
    const s = scoreInstance(inst, cwd);
    if (s > bestScore) {
      bestScore = s;
      best = inst;
    }
  }
  if (best && bestScore >= 70) {
    return {
      port: best.port,
      how: "cwd",
      instance: best,
      score: bestScore,
      workspace: best.primaryName || null,
    };
  }
  if (instances.length === 1) {
    return {
      port: instances[0].port,
      how: "single-instance",
      instance: instances[0],
      workspace: instances[0].primaryName || null,
    };
  }
  throw new Error(
    `Multiple Cursor windows; cannot guess project from cwd (${cwd}).\n` +
      formatWindowsHint(instances)
  );
}

function shellSingleQuote(s) {
  return `'${String(s).replace(/'/g, `'\\''`)}'`;
}

/**
 * Build a pin payload: current project + bridge port for agents to reuse.
 */
function buildPinPayload(target, whoamiData = {}) {
  const ws = whoamiData.workspace || {};
  const workspace =
    ws.primaryName ||
    target.instance?.primaryName ||
    target.workspace ||
    path.basename(process.cwd());
  const workspacePath =
    ws.primaryPath || target.instance?.primaryPath || process.cwd();
  const port = Number(whoamiData.port || target.port);
  const exportsEnv = {
    CURSOR_BROWSER_WORKSPACE: workspace,
    CURSOR_BROWSER_CLI_PORT: String(port),
  };
  return {
    ok: true,
    workspace,
    workspacePath,
    port,
    how: target.how,
    score: target.score ?? null,
    cwd: process.cwd(),
    live: whoamiData.ok !== false && !!whoamiData.version,
    version: whoamiData.version || null,
    instanceId: whoamiData.instanceId || target.instance?.id || null,
    exports: exportsEnv,
    use: {
      env: `export CURSOR_BROWSER_WORKSPACE=${shellSingleQuote(workspace)} CURSOR_BROWSER_CLI_PORT=${port}`,
      flag: `--workspace ${workspace}`,
      portFlag: `--port ${port}`,
      example: `cursor-browser --workspace ${shellSingleQuote(workspace)} open http://localhost:3000`,
    },
    agent: {
      step1: "cursor-browser pin   # or: windows + whoami",
      step2: `export CURSOR_BROWSER_WORKSPACE=${shellSingleQuote(workspace)}`,
      step3: "cursor-browser open <url>   # all later cmds use this project",
      note: "Prefer workspace name over port; ports can change after recover/restart.",
    },
  };
}

function formatPinHuman(pin) {
  const lines = [
    `project:  ${pin.workspace}`,
    `path:     ${pin.workspacePath}`,
    `port:     ${pin.port}`,
    `how:      ${pin.how}${pin.score != null ? ` (score ${pin.score})` : ""}`,
    `live:     ${pin.live ? "yes" : "no"}`,
    "",
    "# Pin this project for the rest of the shell/session:",
    pin.use.env,
    "",
    "# Or pass every time:",
    `# cursor-browser ${pin.use.flag} open <url>`,
    `# cursor-browser ${pin.use.portFlag} open <url>`,
  ];
  return lines.join("\n") + "\n";
}

function formatExportShell(pin) {
  return (
    `export CURSOR_BROWSER_WORKSPACE=${shellSingleQuote(pin.workspace)}\n` +
    `export CURSOR_BROWSER_CLI_PORT=${pin.port}\n`
  );
}

function request(method, pathname, body, port) {
  const payload = body ? JSON.stringify(body) : null;
  return new Promise((resolve, reject) => {
    const req = http.request(
      {
        host: "127.0.0.1",
        port,
        path: pathname,
        method,
        headers: {
          "Content-Type": "application/json",
          ...(payload ? { "Content-Length": Buffer.byteLength(payload) } : {}),
        },
        timeout: 60000,
      },
      (res) => {
        const chunks = [];
        res.on("data", (c) => chunks.push(c));
        res.on("end", () => {
          const raw = Buffer.concat(chunks).toString("utf8");
          let data;
          try {
            data = raw ? JSON.parse(raw) : {};
          } catch {
            data = { ok: false, error: "Non-JSON", raw };
          }
          resolve({ status: res.statusCode, data, port });
        });
      }
    );
    req.on("error", (err) => {
      reject(
        new Error(
          `Cannot reach cursor-browser-cli on 127.0.0.1:${port} (${err.message}).\n` +
            `The Browser Tab can be open while the CLI bridge is DOWN.\n` +
            `Recover:  cursor-browser recover\n` +
            `Diagnose: cursor-browser doctor\n` +
            `Manual:   Cmd+Shift+P → "Cursor Browser CLI: Restart Server"`
        )
      );
    });
    req.on("timeout", () => {
      req.destroy();
      reject(new Error(`Timeout on port ${port}`));
    });
    if (payload) req.write(payload);
    req.end();
  });
}

function saveScreenshot(r, outPath) {
  if (!r || typeof r !== "object") return { path: outPath, bytes: 0 };
  if (r.savedPath && fs.existsSync(r.savedPath)) {
    fs.copyFileSync(r.savedPath, outPath);
    return { path: outPath, bytes: fs.statSync(outPath).size, copiedFrom: r.savedPath };
  }
  if (typeof r.dataUrl === "string" && r.dataUrl.startsWith("data:")) {
    const b64 = r.dataUrl.replace(/^data:image\/\w+;base64,/, "");
    const buf = Buffer.from(b64, "base64");
    fs.mkdirSync(path.dirname(outPath), { recursive: true });
    fs.writeFileSync(outPath, buf);
    return { path: outPath, bytes: buf.length };
  }
  return { path: outPath, bytes: 0, warning: "No image payload" };
}

function extractSnapshotText(data) {
  if (!data || typeof data !== "object") return null;
  // Direct snapshot action: { result: { text, yaml } }
  if (data.result?.text && data.result.yaml !== undefined) {
    return data.result.text;
  }
  // open / nav / interact+--snap: { result: { snapshot: { text, yaml } } }
  if (data.result?.snapshot?.text) {
    return data.result.snapshot.text;
  }
  // Nested under action payload
  if (data.result?.action?.snapshot?.text) {
    return data.result.action.snapshot.text;
  }
  return null;
}

function slimForJson(data) {
  if (!data || typeof data !== "object") return data;
  try {
    const clone = JSON.parse(JSON.stringify(data));
    const dropTree = (snap) => {
      if (snap && typeof snap === "object") delete snap.tree;
    };
    dropTree(clone.result);
    dropTree(clone.result?.snapshot);
    dropTree(clone.result?.action?.snapshot);
    return clone;
  } catch {
    return data;
  }
}

function print(data, { asJson = false } = {}) {
  if (typeof data === "string") {
    process.stdout.write(data.endsWith("\n") ? data : data + "\n");
    return;
  }
  if (!asJson) {
    // pin / resolve / --export
    if (data && data._format === "export-shell" && data.exports) {
      process.stdout.write(formatExportShell(data));
      return;
    }
    if (data && data._format === "pin" && data.workspace && data.port) {
      process.stdout.write(formatPinHuman(data));
      return;
    }
    const snapText = extractSnapshotText(data);
    if (snapText != null) {
      // When open/nav/snap actions also include non-snapshot fields, print snap first
      process.stdout.write(snapText.endsWith("\n") ? snapText : snapText + "\n");
      // If there was a navigation wait or action meta, print a short footer
      const nav = data?.result?.navigation;
      if (nav && typeof nav === "object") {
        process.stdout.write(
          `# navigation: ${nav.ok === false ? "timeout" : "ok"} ${nav.from || ""} → ${nav.url || ""}\n`
        );
      }
      // Always show which project/port served this response (multi-window safety)
      const cli = data?._cli;
      if (cli?.port) {
        process.stdout.write(
          `# bridge: ${cli.workspace || "?"} :${cli.port} (${cli.how || "?"})\n`
        );
      }
      return;
    }
  }
  process.stdout.write(JSON.stringify(slimForJson(data), null, 2) + "\n");
}

function pkgRoot() {
  return path.resolve(__dirname, "..");
}

function runSetup() {
  const setup = path.join(pkgRoot(), "scripts", "setup.js");
  if (!fs.existsSync(setup)) {
    throw new Error(`setup script missing: ${setup}`);
  }
  const mod = require(setup);
  if (typeof mod.main === "function") mod.main();
}

function writeRestartRequest(kind = "restart") {
  fs.mkdirSync(STATE_DIR, { recursive: true });
  const file = kind === "reload" ? REQUEST_RELOAD_FILE : REQUEST_RESTART_FILE;
  fs.writeFileSync(
    file,
    JSON.stringify({ at: new Date().toISOString(), pid: process.pid, kind }) + "\n"
  );
  return file;
}

function clearStaleState() {
  fs.mkdirSync(STATE_DIR, { recursive: true });
  try {
    if (fs.existsSync(PORT_FILE)) fs.unlinkSync(PORT_FILE);
  } catch {
    /* ignore */
  }
  try {
    fs.writeFileSync(INSTANCES_FILE, "{}\n");
  } catch {
    /* ignore */
  }
  try {
    if (fs.existsSync(LEGACY_PORT)) fs.unlinkSync(LEGACY_PORT);
  } catch {
    /* ignore */
  }
}

function extensionInstalled() {
  const extRoot = path.join(os.homedir(), ".cursor", "extensions");
  try {
    return fs
      .readdirSync(extRoot)
      .filter((d) => d.startsWith("local.cursor-browser-cli-"));
  } catch {
    return [];
  }
}

function cursorRunning() {
  try {
    const out = execSync(
      'pgrep -fl "Cursor Helper \\(Plugin\\): extension-host" 2>/dev/null || true',
      { encoding: "utf8" }
    );
    return out.trim().length > 0;
  } catch {
    return false;
  }
}

function tryTriggerRestartViaPeekaboo(workspaceHint) {
  // Optional: peekaboo (macOS UI automation). Not required; AppleScript + file trigger also used.
  const which = (() => {
    try {
      return execSync("which peekaboo 2>/dev/null", { encoding: "utf8" }).trim();
    } catch {
      return "";
    }
  })();
  if (!which) {
    return { ok: false, how: "peekaboo", error: "peekaboo not on PATH (optional)" };
  }
  const hint = workspaceHint || process.env.CURSOR_BROWSER_WORKSPACE || "";
  const focus =
    hint && !hint.includes("/")
      ? `peekaboo window focus --app Cursor --window-title ${JSON.stringify(hint)} || true`
      : hint
        ? `peekaboo window focus --app Cursor --window-title ${JSON.stringify(path.basename(hint))} || true`
        : "true";
  const runPalette = (commandTitle) => {
    const cmds = [
      "peekaboo app switch --to Cursor",
      focus,
      'peekaboo hotkey --keys "cmd,shift,p"',
      "sleep 0.7",
      `peekaboo type ${JSON.stringify(commandTitle)} --wpm 180`,
      "sleep 0.4",
      'peekaboo hotkey --keys "return"',
    ];
    execSync(cmds.join(" && "), {
      stdio: "ignore",
      timeout: 45000,
      shell: "/bin/bash",
    });
  };
  try {
    runPalette("Cursor Browser CLI: Restart Server");
    return { ok: true, how: "peekaboo-restart-server", workspaceHint: hint || null };
  } catch (err) {
    try {
      runPalette("Developer: Reload Window");
      return { ok: true, how: "peekaboo-reload-window", workspaceHint: hint || null };
    } catch (err2) {
      return {
        ok: false,
        how: "peekaboo",
        error: String(err2 && err2.message ? err2.message : err2),
      };
    }
  }
}

function tryTriggerRestartViaAppleScript() {
  // Best-effort: open Command Palette and run Restart Server.
  // Requires Accessibility permission for the process running this CLI.
  const scriptPath = path.join(os.tmpdir(), "cursor-browser-recover.applescript");
  const script = [
    'tell application "Cursor" to activate',
    "delay 0.8",
    'tell application "System Events"',
    "  tell process \"Cursor\"",
    "    keystroke \"p\" using {command down, shift down}",
    "    delay 0.6",
    '    keystroke "Cursor Browser CLI: Restart Server"',
    "    delay 0.5",
    "    key code 36",
    "  end tell",
    "end tell",
    "",
  ].join("\n");
  try {
    fs.writeFileSync(scriptPath, script);
    execSync(`osascript ${JSON.stringify(scriptPath)}`, {
      stdio: ["ignore", "pipe", "pipe"],
      timeout: 20000,
    });
    return { ok: true, how: "applescript-command-palette", scriptPath };
  } catch (err) {
    const msg = String(err && err.message ? err.message : err);
    const stderr = err && err.stderr ? String(err.stderr) : "";
    return {
      ok: false,
      how: "applescript-command-palette",
      error: msg,
      stderr: stderr.slice(0, 500),
      hint: "Grant Accessibility to Cursor/Terminal (System Settings → Privacy → Accessibility), or run Restart Server manually.",
    };
  }
}

async function waitForBridge(timeoutMs = 12000) {
  const start = Date.now();
  while (Date.now() - start < timeoutMs) {
    const live = listInstances().filter((i) => portIsAlive(i.port));
    if (live.length) return live;
    // also scan preferred range even if registry empty
    for (let p = DEFAULT_PORT; p < DEFAULT_PORT + 32; p++) {
      if (portIsAlive(p)) {
        return [{ port: p, primaryName: "discovered", discovered: true }];
      }
    }
    await new Promise((r) => setTimeout(r, 500));
  }
  return [];
}

async function runDoctor({ asJson = false } = {}) {
  pruneStaleRegistry();
  const portsLive = [];
  for (let p = DEFAULT_PORT; p < DEFAULT_PORT + 32; p++) {
    if (portIsAlive(p)) portsLive.push(p);
  }
  const report = {
    ok: portsLive.length > 0,
    cli: process.argv[1],
    stateDir: STATE_DIR,
    portFile: fs.existsSync(PORT_FILE)
      ? fs.readFileSync(PORT_FILE, "utf8").trim()
      : null,
    instancesFile: readInstances(),
    instancesLive: listInstances(),
    portsListening173xx: portsLive,
    extensionInstalled: extensionInstalled(),
    cursorExtensionHostsRunning: cursorRunning(),
    bridgeLogTail: (() => {
      try {
        const log = path.join(STATE_DIR, "bridge.log");
        if (!fs.existsSync(log)) return null;
        const lines = fs.readFileSync(log, "utf8").trim().split("\n");
        return lines.slice(-8);
      } catch {
        return null;
      }
    })(),
    diagnosis: [],
    fix: [],
  };

  if (!report.extensionInstalled.length) {
    report.diagnosis.push("Extension not installed under ~/.cursor/extensions");
    report.fix.push("Run: cursor-browser setup  then  Developer: Reload Window");
  }
  if (!report.cursorExtensionHostsRunning) {
    report.diagnosis.push("Cursor extension hosts not running — open Cursor");
    report.fix.push("Open the target project folder in a Cursor window");
  }
  if (!portsLive.length) {
    report.diagnosis.push(
      "CLI bridge HTTP server is DOWN (nothing on 127.0.0.1:1737x). " +
        "Browser Tab can still show pages — that is separate from this bridge."
    );
    report.fix.push('Cmd+Shift+P → "Cursor Browser CLI: Restart Server"');
    report.fix.push("Or: cursor-browser recover");
    report.fix.push(
      "If command missing: Extensions → enable Cursor Browser CLI → Reload Window"
    );
  } else {
    report.diagnosis.push(`Bridge alive on port(s): ${portsLive.join(", ")}`);
  }
  if (report.portFile && !portsLive.includes(Number(report.portFile))) {
    report.diagnosis.push(
      `Stale port file points to dead port ${report.portFile}`
    );
    report.fix.push("cursor-browser recover  (clears stale state)");
  }

  print(report, { asJson });
  return report;
}

async function runRecover({ asJson = false, workspaceHint = null } = {}) {
  const steps = [];
  const triggers = [];

  steps.push("clear-stale-state");
  clearStaleState();

  // If any extension host is already alive, it may pick this up via file watcher
  steps.push("write-request-restart");
  writeRestartRequest("restart");

  if (cursorRunning()) {
    steps.push("ui-automation-restart");
    let trigger = tryTriggerRestartViaPeekaboo(workspaceHint);
    triggers.push(trigger);
    if (!trigger.ok) {
      trigger = tryTriggerRestartViaAppleScript();
      triggers.push(trigger);
    }
    // If still down after short wait, request reload (full extension re-activate)
    let liveProbe = await waitForBridge(4000);
    if (!liveProbe.length) {
      steps.push("write-request-reload");
      writeRestartRequest("reload");
      steps.push("ui-automation-reload");
      const reloadTrigger = tryTriggerRestartViaPeekaboo(workspaceHint);
      // force reload path explicitly if restart typed again failed
      if (!reloadTrigger.ok || reloadTrigger.how === "peekaboo-restart-server") {
        try {
          // second attempt: palette Reload Window only via AppleScript-like peekaboo helper
          const which = execSync("which peekaboo 2>/dev/null || true", {
            encoding: "utf8",
          }).trim();
          if (which) {
            execSync(
              [
                "peekaboo app switch --to Cursor",
                'peekaboo hotkey --keys "cmd,shift,p"',
                "sleep 0.7",
                'peekaboo type "Developer: Reload Window" --wpm 180',
                "sleep 0.4",
                'peekaboo hotkey --keys "return"',
              ].join(" && "),
              { stdio: "ignore", timeout: 45000, shell: "/bin/bash" }
            );
            triggers.push({ ok: true, how: "peekaboo-reload-window-forced" });
          }
        } catch (e) {
          triggers.push({
            ok: false,
            how: "peekaboo-reload-window-forced",
            error: String(e && e.message ? e.message : e),
          });
        }
      } else {
        triggers.push(reloadTrigger);
      }
    }
  } else {
    steps.push("cursor-not-running");
  }

  steps.push("wait-for-bridge-15s");
  const live = await waitForBridge(15000);

  const result = {
    ok: live.length > 0,
    steps,
    triggers,
    liveInstances: live,
    next:
      live.length > 0
        ? [
            "cursor-browser windows",
            "cursor-browser --workspace <project> open <url>",
          ]
        : [
            "Bridge still down. Ensure Cursor is open with the project folder.",
            "Extensions: enable **Cursor Browser CLI** (local.cursor-browser-cli).",
            'Cmd+Shift+P → "Cursor Browser CLI: Restart Server" or "Developer: Reload Window".',
            "Then: cursor-browser doctor && cursor-browser windows",
          ],
  };
  print(result, { asJson });
  if (!result.ok) process.exit(2);
  return result;
}

