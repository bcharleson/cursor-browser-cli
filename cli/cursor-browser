#!/usr/bin/env node
/**
 * cursor-browser — CLI for Cursor Browser CLI
 * Multi-window aware client for the Cursor Browser Tab bridge.
 */
const fs = require("fs");
const os = require("os");
const path = require("path");
const http = require("http");
const { execSync } = require("child_process");

const STATE_DIR = path.join(os.homedir(), ".cursor-browser-cli");
const INSTANCES_FILE = path.join(STATE_DIR, "instances.json");
const PORT_FILE = path.join(STATE_DIR, "port");
const LEGACY_INSTANCES = path.join(
  os.homedir(),
  ".cursor-browser-bridge",
  "instances.json"
);
const LEGACY_PORT = path.join(os.homedir(), ".cursor-browser-bridge", "port");
const DEFAULT_PORT = 17373;
const REQUEST_RESTART_FILE = path.join(STATE_DIR, "request-restart");
const REQUEST_RELOAD_FILE = path.join(STATE_DIR, "request-reload");
/** Same version as the repo package.json (npm + extension). */
const CLI_VERSION = JSON.parse(
  fs.readFileSync(path.join(__dirname, "..", "package.json"), "utf8")
).version;

function readInstances() {
  for (const f of [INSTANCES_FILE, LEGACY_INSTANCES]) {
    try {
      if (fs.existsSync(f)) {
        return JSON.parse(fs.readFileSync(f, "utf8") || "{}");
      }
    } catch {
      /* ignore */
    }
  }
  return {};
}

function discoverInstancesFromProcesses() {
  const found = [];
  try {
    const lsof = execSync(
      "lsof -nP -iTCP -sTCP:LISTEN 2>/dev/null | grep -E '127\\.0\\.0\\.1:173[0-9]{2}' || true",
      { encoding: "utf8" }
    );
    for (const line of lsof.split("\n")) {
      if (!line.trim()) continue;
      const parts = line.trim().split(/\s+/);
      const pid = Number(parts[1]);
      const nameField = parts.find((p) => p.includes("127.0.0.1:"));
      if (!pid || !nameField) continue;
      const m = nameField.match(/:(\d+)$/);
      if (!m) continue;
      const port = Number(m[1]);
      let primaryName = null;
      try {
        const ps = execSync(`ps -p ${pid} -o command= 2>/dev/null || true`, {
          encoding: "utf8",
        });
        const mm = ps.match(/extension-host\s+\([^)]+\)\s+([^\s\[]+)/i);
        if (mm) primaryName = mm[1].trim();
      } catch {
        /* ignore */
      }
      found.push({
        id: `discovered-${port}`,
        port,
        pid,
        primaryName,
        primaryPath: primaryName
          ? path.join(os.homedir(), "Developer", primaryName)
          : null,
        workspaceNames: primaryName ? [primaryName] : [],
        workspacePaths: primaryName
          ? [path.join(os.homedir(), "Developer", primaryName)]
          : [],
        basenames: primaryName ? [primaryName] : [],
        discovered: true,
      });
    }
  } catch {
    /* ignore */
  }
  return found;
}

function portIsAlive(port) {
  try {
    // Fast TCP connect (does not require curl). Bridge answers on 1737x when up.
    execSync(
      `node -e "const n=require('net');const s=n.connect(${Number(port)},'127.0.0.1',()=>{s.end();process.exit(0)});s.on('error',()=>process.exit(1));setTimeout(()=>process.exit(1),400);"`,
      { stdio: "ignore" }
    );
    return true;
  } catch {
    return false;
  }
}

function pruneStaleRegistry() {
  const map = readInstances();
  let changed = false;
  for (const [id, inst] of Object.entries(map)) {
    const port = Number(inst.port);
    if (!port || !portIsAlive(port)) {
      delete map[id];
      changed = true;
    }
  }
  if (changed) {
    try {
      fs.mkdirSync(STATE_DIR, { recursive: true });
      fs.writeFileSync(INSTANCES_FILE, JSON.stringify(map, null, 2));
    } catch {
      /* ignore */
    }
  }
  return map;
}

function listInstances() {
  const map = pruneStaleRegistry();
  const byPort = new Map();
  for (const inst of Object.values(map)) {
    if (inst.port) byPort.set(Number(inst.port), inst);
  }
  for (const inst of discoverInstancesFromProcesses()) {
    if (!byPort.has(Number(inst.port))) byPort.set(Number(inst.port), inst);
  }
  return Array.from(byPort.values()).sort((a, b) =>
    String(a.primaryName || "").localeCompare(String(b.primaryName || ""))
  );
}

function scoreInstance(inst, query) {
  if (!query) return 0;
  const q = path.resolve(query);
  const qBase = path.basename(q).toLowerCase();
  const qLower = String(query).toLowerCase();
  let score = 0;
  const paths = inst.workspacePaths || (inst.primaryPath ? [inst.primaryPath] : []);
  const names = inst.workspaceNames || (inst.primaryName ? [inst.primaryName] : []);
  const bases = inst.basenames || paths.map((p) => path.basename(p));
  for (const p of paths) {
    const rp = path.resolve(p);
    if (q === rp) score = Math.max(score, 100);
    else if (q.startsWith(rp + path.sep)) score = Math.max(score, 90);
  }
  for (const b of bases) {
    if (b.toLowerCase() === qBase || b.toLowerCase() === qLower)
      score = Math.max(score, 80);
  }
  for (const n of names) {
    if (n.toLowerCase() === qLower) score = Math.max(score, 85);
  }
  return score;
}

function formatWindowsHint(instances) {
  return (
    instances
      .map((i) => `  :${i.port}  ${i.primaryName || "?"}  ${i.primaryPath || ""}`)
      .join("\n") +
    `\nDiscover: cursor-browser windows\nPin:      cursor-browser pin\nUse:      cursor-browser --workspace <name> <cmd>`
  );
}

/**
 * Resolve which Cursor window/bridge to talk to.
 * Order: explicit port → --workspace / env → cwd match → single instance.
 * Never silently picks another project when multiple bridges are live.
 */
function resolveTarget(opts = {}) {
  if (opts.port || process.env.CURSOR_BROWSER_BRIDGE_PORT || process.env.CURSOR_BROWSER_CLI_PORT) {
    const port = Number(
      opts.port ||
        process.env.CURSOR_BROWSER_CLI_PORT ||
        process.env.CURSOR_BROWSER_BRIDGE_PORT
    );
    const instances = listInstances();
    const instance = instances.find((i) => Number(i.port) === port) || null;
    return {
      port,
      how: "explicit-port",
      instance,
      workspace: instance?.primaryName || null,
    };
  }
  const instances = listInstances();
  const query =
    opts.workspace ||
    process.env.CURSOR_BROWSER_WORKSPACE ||
    process.env.CURSOR_BROWSER_PROJECT ||
    null;

  if (!instances.length) {
    // Only use shared port-file when no registry — never as multi-project fallback.
    for (const f of [PORT_FILE, LEGACY_PORT]) {
      try {
        if (fs.existsSync(f)) {
          const n = Number(fs.readFileSync(f, "utf8").trim());
          if (n > 0 && portIsAlive(n)) return { port: n, how: "port-file", instance: null };
        }
      } catch {
        /* ignore */
      }
    }
    return { port: DEFAULT_PORT, how: "default-no-bridge", instance: null };
  }

  if (query) {
    let best = null;
    let bestScore = 0;
    for (const inst of instances) {
      const s = scoreInstance(inst, query);
      if (s > bestScore) {
        bestScore = s;
        best = inst;
      }
    }
    if (best && bestScore >= 50) {
      return {
        port: best.port,
        how: "workspace-query",
        instance: best,
        score: bestScore,
        workspace: best.primaryName || null,
      };
    }
    throw new Error(
      `No bridge matched workspace "${query}".\n` + formatWindowsHint(instances)
    );
  }

  const cwd = process.cwd();
  let best = null;
  let bestScore = 0;
  for (const inst of instances) {
    const s = scoreInstance(inst, cwd);
    if (s > bestScore) {
      bestScore = s;
      best = inst;
    }
  }
  if (best && bestScore >= 70) {
    return {
      port: best.port,
      how: "cwd",
      instance: best,
      score: bestScore,
      workspace: best.primaryName || null,
    };
  }
  if (instances.length === 1) {
    return {
      port: instances[0].port,
      how: "single-instance",
      instance: instances[0],
      workspace: instances[0].primaryName || null,
    };
  }
  throw new Error(
    `Multiple Cursor windows; cannot guess project from cwd (${cwd}).\n` +
      formatWindowsHint(instances)
  );
}

function shellSingleQuote(s) {
  return `'${String(s).replace(/'/g, `'\\''`)}'`;
}

/**
 * Build a pin payload: current project + bridge port for agents to reuse.
 */
function buildPinPayload(target, whoamiData = {}) {
  const ws = whoamiData.workspace || {};
  const workspace =
    ws.primaryName ||
    target.instance?.primaryName ||
    target.workspace ||
    path.basename(process.cwd());
  const workspacePath =
    ws.primaryPath || target.instance?.primaryPath || process.cwd();
  const port = Number(whoamiData.port || target.port);
  const exportsEnv = {
    CURSOR_BROWSER_WORKSPACE: workspace,
    CURSOR_BROWSER_CLI_PORT: String(port),
  };
  return {
    ok: true,
    workspace,
    workspacePath,
    port,
    how: target.how,
    score: target.score ?? null,
    cwd: process.cwd(),
    live: whoamiData.ok !== false && !!whoamiData.version,
    version: whoamiData.version || null,
    instanceId: whoamiData.instanceId || target.instance?.id || null,
    exports: exportsEnv,
    use: {
      env: `export CURSOR_BROWSER_WORKSPACE=${shellSingleQuote(workspace)} CURSOR_BROWSER_CLI_PORT=${port}`,
      flag: `--workspace ${workspace}`,
      portFlag: `--port ${port}`,
      example: `cursor-browser --workspace ${shellSingleQuote(workspace)} open http://localhost:3000`,
    },
    agent: {
      step1: "cursor-browser pin   # or: windows + whoami",
      step2: `export CURSOR_BROWSER_WORKSPACE=${shellSingleQuote(workspace)}`,
      step3: "cursor-browser open <url>   # all later cmds use this project",
      note: "Prefer workspace name over port; ports can change after recover/restart.",
    },
  };
}

function formatPinHuman(pin) {
  const lines = [
    `project:  ${pin.workspace}`,
    `path:     ${pin.workspacePath}`,
    `port:     ${pin.port}`,
    `how:      ${pin.how}${pin.score != null ? ` (score ${pin.score})` : ""}`,
    `live:     ${pin.live ? "yes" : "no"}`,
    "",
    "# Pin this project for the rest of the shell/session:",
    pin.use.env,
    "",
    "# Or pass every time:",
    `# cursor-browser ${pin.use.flag} open <url>`,
    `# cursor-browser ${pin.use.portFlag} open <url>`,
  ];
  return lines.join("\n") + "\n";
}

function formatExportShell(pin) {
  return (
    `export CURSOR_BROWSER_WORKSPACE=${shellSingleQuote(pin.workspace)}\n` +
    `export CURSOR_BROWSER_CLI_PORT=${pin.port}\n`
  );
}

function request(method, pathname, body, port) {
  const payload = body ? JSON.stringify(body) : null;
  return new Promise((resolve, reject) => {
    const req = http.request(
      {
        host: "127.0.0.1",
        port,
        path: pathname,
        method,
        headers: {
          "Content-Type": "application/json",
          ...(payload ? { "Content-Length": Buffer.byteLength(payload) } : {}),
        },
        timeout: 60000,
      },
      (res) => {
        const chunks = [];
        res.on("data", (c) => chunks.push(c));
        res.on("end", () => {
          const raw = Buffer.concat(chunks).toString("utf8");
          let data;
          try {
            data = raw ? JSON.parse(raw) : {};
          } catch {
            data = { ok: false, error: "Non-JSON", raw };
          }
          resolve({ status: res.statusCode, data, port });
        });
      }
    );
    req.on("error", (err) => {
      reject(
        new Error(
          `Cannot reach cursor-browser-cli on 127.0.0.1:${port} (${err.message}).\n` +
            `The Browser Tab can be open while the CLI bridge is DOWN.\n` +
            `Recover:  cursor-browser recover\n` +
            `Diagnose: cursor-browser doctor\n` +
            `Manual:   Cmd+Shift+P → "Cursor Browser CLI: Restart Server"`
        )
      );
    });
    req.on("timeout", () => {
      req.destroy();
      reject(new Error(`Timeout on port ${port}`));
    });
    if (payload) req.write(payload);
    req.end();
  });
}

function saveScreenshot(r, outPath) {
  if (!r || typeof r !== "object") return { path: outPath, bytes: 0 };
  if (r.savedPath && fs.existsSync(r.savedPath)) {
    fs.copyFileSync(r.savedPath, outPath);
    return { path: outPath, bytes: fs.statSync(outPath).size, copiedFrom: r.savedPath };
  }
  if (typeof r.dataUrl === "string" && r.dataUrl.startsWith("data:")) {
    const b64 = r.dataUrl.replace(/^data:image\/\w+;base64,/, "");
    const buf = Buffer.from(b64, "base64");
    fs.mkdirSync(path.dirname(outPath), { recursive: true });
    fs.writeFileSync(outPath, buf);
    return { path: outPath, bytes: buf.length };
  }
  return { path: outPath, bytes: 0, warning: "No image payload" };
}

function extractSnapshotText(data) {
  if (!data || typeof data !== "object") return null;
  // Direct snapshot action: { result: { text, yaml } }
  if (data.result?.text && data.result.yaml !== undefined) {
    return data.result.text;
  }
  // open / nav / interact+--snap: { result: { snapshot: { text, yaml } } }
  if (data.result?.snapshot?.text) {
    return data.result.snapshot.text;
  }
  // Nested under action payload
  if (data.result?.action?.snapshot?.text) {
    return data.result.action.snapshot.text;
  }
  return null;
}

function slimForJson(data) {
  if (!data || typeof data !== "object") return data;
  try {
    const clone = JSON.parse(JSON.stringify(data));
    const dropTree = (snap) => {
      if (snap && typeof snap === "object") delete snap.tree;
    };
    dropTree(clone.result);
    dropTree(clone.result?.snapshot);
    dropTree(clone.result?.action?.snapshot);
    return clone;
  } catch {
    return data;
  }
}

function print(data, { asJson = false } = {}) {
  if (typeof data === "string") {
    process.stdout.write(data.endsWith("\n") ? data : data + "\n");
    return;
  }
  if (!asJson) {
    // pin / resolve / --export
    if (data && data._format === "export-shell" && data.exports) {
      process.stdout.write(formatExportShell(data));
      return;
    }
    if (data && data._format === "pin" && data.workspace && data.port) {
      process.stdout.write(formatPinHuman(data));
      return;
    }
    const snapText = extractSnapshotText(data);
    if (snapText != null) {
      // When open/nav/snap actions also include non-snapshot fields, print snap first
      process.stdout.write(snapText.endsWith("\n") ? snapText : snapText + "\n");
      // If there was a navigation wait or action meta, print a short footer
      const nav = data?.result?.navigation;
      if (nav && typeof nav === "object") {
        process.stdout.write(
          `# navigation: ${nav.ok === false ? "timeout" : "ok"} ${nav.from || ""} → ${nav.url || ""}\n`
        );
      }
      // Always show which project/port served this response (multi-window safety)
      const cli = data?._cli;
      if (cli?.port) {
        process.stdout.write(
          `# bridge: ${cli.workspace || "?"} :${cli.port} (${cli.how || "?"})\n`
        );
      }
      return;
    }
  }
  process.stdout.write(JSON.stringify(slimForJson(data), null, 2) + "\n");
}

function pkgRoot() {
  return path.resolve(__dirname, "..");
}

function runSetup() {
  const setup = path.join(pkgRoot(), "scripts", "setup.js");
  if (!fs.existsSync(setup)) {
    throw new Error(`setup script missing: ${setup}`);
  }
  const mod = require(setup);
  if (typeof mod.main === "function") mod.main();
}

function writeRestartRequest(kind = "restart") {
  fs.mkdirSync(STATE_DIR, { recursive: true });
  const file = kind === "reload" ? REQUEST_RELOAD_FILE : REQUEST_RESTART_FILE;
  // Unique token so EVERY Cursor window can handle the same request once
  // (extensions no longer delete the file; we clear after wait).
  const token = `${Date.now()}-${process.pid}-${Math.random().toString(36).slice(2, 10)}`;
  fs.writeFileSync(
    file,
    JSON.stringify({
      at: new Date().toISOString(),
      pid: process.pid,
      kind,
      token,
      cliVersion: CLI_VERSION,
    }) + "\n"
  );
  return { file, token };
}

function clearRequestFiles() {
  for (const f of [REQUEST_RESTART_FILE, REQUEST_RELOAD_FILE]) {
    try {
      if (fs.existsSync(f)) fs.unlinkSync(f);
    } catch {
      /* ignore */
    }
  }
}

function clearStaleState() {
  fs.mkdirSync(STATE_DIR, { recursive: true });
  try {
    if (fs.existsSync(PORT_FILE)) fs.unlinkSync(PORT_FILE);
  } catch {
    /* ignore */
  }
  // Soft prune: drop dead ports only (do not wipe live multi-window registry)
  pruneStaleRegistry();
  try {
    if (fs.existsSync(LEGACY_PORT)) fs.unlinkSync(LEGACY_PORT);
  } catch {
    /* ignore */
  }
}

function extensionInstalled() {
  const extRoot = path.join(os.homedir(), ".cursor", "extensions");
  try {
    return fs
      .readdirSync(extRoot)
      .filter(
        (d) =>
          d.startsWith("bcharleson.cursor-browser-cli-") ||
          d.startsWith("local.cursor-browser-cli-")
      );
  } catch {
    return [];
  }
}

function cursorRunning() {
  try {
    const out = execSync(
      'pgrep -fl "Cursor Helper \\(Plugin\\): extension-host" 2>/dev/null || true',
      { encoding: "utf8" }
    );
    return out.trim().length > 0;
  } catch {
    return false;
  }
}

/**
 * Self-heal via extension file triggers only (no UI automation).
 *
 * The Cursor extension polls/watches:
 *   ~/.cursor-browser-cli/request-restart  → restartServer()
 *   ~/.cursor-browser-cli/request-reload   → Reload Window (re-activate extension)
 */
async function waitForBridge(timeoutMs = 12000) {
  const start = Date.now();
  while (Date.now() - start < timeoutMs) {
    const live = listInstances().filter((i) => portIsAlive(i.port));
    if (live.length) return live;
    for (let p = DEFAULT_PORT; p < DEFAULT_PORT + 32; p++) {
      if (portIsAlive(p)) {
        return [{ port: p, primaryName: "discovered", discovered: true }];
      }
    }
    await new Promise((r) => setTimeout(r, 400));
  }
  return [];
}

function pendingRequestAgeMs(file) {
  try {
    if (!fs.existsSync(file)) return null;
    const st = fs.statSync(file);
    return Date.now() - st.mtimeMs;
  } catch {
    return null;
  }
}

async function probeLiveVersions() {
  const live = listInstances().filter((i) => portIsAlive(i.port));
  const out = [];
  for (const inst of live) {
    try {
      const r = await request("GET", "/whoami", null, inst.port);
      out.push({
        port: inst.port,
        primaryName:
          r.data?.workspace?.primaryName || inst.primaryName || null,
        version: r.data?.version || null,
        live: true,
      });
    } catch {
      out.push({
        port: inst.port,
        primaryName: inst.primaryName || null,
        version: null,
        live: portIsAlive(inst.port),
      });
    }
  }
  return out;
}

function versionSkew(probed, expected = CLI_VERSION) {
  const stale = probed.filter(
    (p) => p.live && p.version && p.version !== expected
  );
  const unknown = probed.filter((p) => p.live && !p.version);
  return { stale, unknown, expected };
}

async function runDoctor({ asJson = false } = {}) {
  pruneStaleRegistry();
  const portsLive = [];
  for (let p = DEFAULT_PORT; p < DEFAULT_PORT + 32; p++) {
    if (portIsAlive(p)) portsLive.push(p);
  }
  const restartAge = pendingRequestAgeMs(REQUEST_RESTART_FILE);
  const reloadAge = pendingRequestAgeMs(REQUEST_RELOAD_FILE);
  const probed = portsLive.length ? await probeLiveVersions() : [];
  const skew = versionSkew(probed);
  const report = {
    ok: portsLive.length > 0 && skew.stale.length === 0,
    cli: process.argv[1],
    version: CLI_VERSION,
    stateDir: STATE_DIR,
    portFile: fs.existsSync(PORT_FILE)
      ? fs.readFileSync(PORT_FILE, "utf8").trim()
      : null,
    instancesFile: readInstances(),
    instancesLive: listInstances(),
    bridges: probed,
    portsListening173xx: portsLive,
    extensionInstalled: extensionInstalled(),
    cursorExtensionHostsRunning: cursorRunning(),
    pendingRequests: {
      restart:
        restartAge == null
          ? null
          : { ageMs: restartAge, path: REQUEST_RESTART_FILE },
      reload:
        reloadAge == null ? null : { ageMs: reloadAge, path: REQUEST_RELOAD_FILE },
    },
    bridgeLogTail: (() => {
      try {
        const log = path.join(STATE_DIR, "bridge.log");
        if (!fs.existsSync(log)) return null;
        const lines = fs.readFileSync(log, "utf8").trim().split("\n");
        return lines.slice(-12);
      } catch {
        return null;
      }
    })(),
    diagnosis: [],
    fix: [],
    selfHeal: {
      method: "extension-file-trigger + multi-window tokens + heartbeat",
    },
  };

  if (!report.extensionInstalled.length) {
    report.diagnosis.push("Extension not installed under ~/.cursor/extensions");
    report.fix.push("Run: cursor-browser setup   then  Developer: Reload Window");
  }
  if (!report.cursorExtensionHostsRunning) {
    report.diagnosis.push("Cursor extension hosts not running — open Cursor");
    report.fix.push("Open the target project folder in a Cursor window");
  }
  if (!portsLive.length) {
    report.diagnosis.push(
      "CLI bridge HTTP server is DOWN (nothing on 127.0.0.1:1737x). " +
        "Browser Tab can still show pages — that is separate from this bridge."
    );
    report.fix.push(
      "cursor-browser recover   # file-trigger self-heal"
    );
    report.fix.push(
      "cursor-browser ensure    # diagnose + heal + verify"
    );
    report.fix.push(
      'If still down: Cmd+Shift+P → "Cursor Browser CLI: Restart Server"'
    );
    report.fix.push(
      "If command missing: Extensions → enable Cursor Browser CLI → Reload Window"
    );
  } else {
    report.diagnosis.push(`Bridge alive on port(s): ${portsLive.join(", ")}`);
  }
  if (skew.stale.length) {
    report.diagnosis.push(
      `Version skew: CLI is ${CLI_VERSION} but live bridges still report: ` +
        skew.stale
          .map((s) => `${s.primaryName || s.port}=${s.version}`)
          .join(", ") +
        ". Extension hosts need a window reload to load new code (restart alone is not enough)."
    );
    report.fix.push(
      "cursor-browser recover --reload   # multi-window file-trigger reload"
    );
    report.fix.push("cursor-browser ensure --reload");
  }
  if (report.portFile && !portsLive.includes(Number(report.portFile))) {
    report.diagnosis.push(
      `Stale port file points to dead port ${report.portFile}`
    );
    report.fix.push(
      "cursor-browser recover  (clears stale state + request-restart)"
    );
  }
  if (restartAge != null && restartAge > 8000 && !portsLive.length) {
    report.diagnosis.push(
      `request-restart pending ${Math.round(restartAge / 1000)}s — extension is NOT polling (not activated or host stuck)`
    );
    report.fix.push(
      'Cmd+Shift+P → "Cursor Browser CLI: Restart Server" or "Developer: Reload Window"'
    );
  }

  print(report, { asJson });
  return report;
}

/**
 * Self-heal bridge without UI automation.
 * 1) prune dead ports
 * 2) write request-restart token (ALL windows restart; they do not delete the file)
 * 3) wait
 * 4) optional / fallback: request-reload token (ALL windows reload)
 * 5) clear request files
 *
 * @param {{ asJson?: boolean, workspaceHint?: string|null, forceReload?: boolean }} opts
 */
async function runRecover({
  asJson = false,
  workspaceHint = null,
  forceReload = false,
  noExit = false,
  quiet = false,
} = {}) {
  const steps = [];
  const triggers = [];
  void workspaceHint; // reserved for future workspace-scoped triggers

  steps.push("clear-stale-state");
  clearStaleState();

  let live = [];

  if (forceReload) {
    // Code update path: HTTP restart cannot swap loaded extension JS
    steps.push("write-request-reload");
    const { file, token } = writeRestartRequest("reload");
    triggers.push({
      ok: true,
      how: "file-request-reload",
      path: file,
      token,
      note: "Every extension host reloads once per token (multi-window safe on 1.2.2+)",
    });
    steps.push("wait-for-bridge-15s-after-reload");
    live = await waitForBridge(15000);

    // Probe versions early — pre-1.2.2 hosts delete the reload file after first window
    let earlyBridges = [];
    try {
      earlyBridges = await probeLiveVersions();
    } catch {
      /* ignore */
    }
    let earlySkew = versionSkew(earlyBridges);
    if (
      earlySkew.stale.length > 0 ||
      !earlyBridges.length ||
      earlyBridges.every((b) => b.version !== CLI_VERSION)
    ) {
      // Last resort: recycle user extension hosts so Cursor reloads extension JS from disk
      steps.push("recycle-user-extension-hosts");
      const killed = recycleUserExtensionHosts();
      triggers.push({
        ok: true,
        how: "sigterm-user-extension-hosts",
        killed,
        note: "No UI automation — Cursor respawns hosts and re-activates from disk",
      });
      // Leave a restart token for hosts as they come back
      writeRestartRequest("restart");
      steps.push("wait-for-bridge-30s-after-recycle");
      live = await waitForBridge(30000);
    } else {
      steps.push("write-request-restart-after-reload");
      const r2 = writeRestartRequest("restart");
      triggers.push({
        ok: true,
        how: "file-request-restart-after-reload",
        token: r2.token,
      });
      steps.push("wait-for-bridge-10s");
      live = await waitForBridge(10000);
    }
  } else {
    steps.push("write-request-restart");
    const r1 = writeRestartRequest("restart");
    triggers.push({
      ok: true,
      how: "file-request-restart",
      path: r1.file,
      token: r1.token,
      note: "Every extension host restarts HTTP once per token (multi-window safe)",
    });

    if (!cursorRunning()) {
      steps.push("cursor-not-running");
    }

    steps.push("wait-for-bridge-10s");
    live = await waitForBridge(10000);

    if (!live.length) {
      steps.push("write-request-restart-retry");
      const rRetry = writeRestartRequest("restart");
      triggers.push({
        ok: true,
        how: "file-request-restart-retry",
        token: rRetry.token,
      });
      steps.push("wait-for-bridge-10s-retry");
      live = await waitForBridge(10000);
    }

    if (!live.length && cursorRunning()) {
      steps.push("write-request-reload");
      const rReload = writeRestartRequest("reload");
      triggers.push({
        ok: true,
        how: "file-request-reload",
        path: rReload.file,
        token: rReload.token,
        note: "Extension executes workbench.action.reloadWindow then rebinds port",
      });
      steps.push("wait-for-bridge-25s-after-reload");
      live = await waitForBridge(25000);
    }

    if (!live.length) {
      steps.push("write-request-restart-final");
      writeRestartRequest("restart");
      live = await waitForBridge(8000);
    }
  }

  // Give multi-window hosts a moment after last write, then clear triggers
  await new Promise((r) => setTimeout(r, 1500));
  steps.push("clear-request-files");
  clearRequestFiles();

  // Re-probe versions when possible
  let bridges = [];
  try {
    bridges = await probeLiveVersions();
  } catch {
    bridges = live;
  }
  const skew = versionSkew(bridges);
  const versionsOk = bridges.length > 0 && skew.stale.length === 0;

  const result = {
    ok: live.length > 0,
    versionsOk,
    version: CLI_VERSION,
    selfHeal: {
      method: "extension-file-trigger-multi-window",
    },
    steps,
    triggers,
    liveInstances: live,
    bridges,
    versionSkew: skew.stale,
    next:
      live.length > 0
        ? versionsOk
          ? [
              "cursor-browser doctor",
              "cursor-browser windows",
              "cursor-browser --workspace <project> open <url>",
            ]
          : [
              "Bridges are up but still on an old extension version.",
              "cursor-browser recover --reload",
              "Or: Cmd+Shift+P → Developer: Reload Window (each project)",
            ]
        : [
            "Bridge still down after file-trigger self-heal.",
            "Extension must be loaded in a Cursor window with a folder open.",
            `1) Extensions: enable **Cursor Browser CLI** (bcharleson.cursor-browser-cli-${CLI_VERSION})`,
            '2) Cmd+Shift+P → "Cursor Browser CLI: Restart Server"',
            '   or "Developer: Reload Window" (re-runs activate + listen)',
            "3) cursor-browser ensure",
          ],
  };
  if (!quiet) print(result, { asJson });
  if (!result.ok && !noExit) process.exit(2);
  return result;
}

async function runDoctorSilent() {
  pruneStaleRegistry();
  const portsLive = [];
  for (let p = DEFAULT_PORT; p < DEFAULT_PORT + 32; p++) {
    if (portIsAlive(p)) portsLive.push(p);
  }
  const bridges = portsLive.length ? await probeLiveVersions() : [];
  const skew = versionSkew(bridges);
  return {
    ok: portsLive.length > 0 && skew.stale.length === 0,
    portsListening173xx: portsLive,
    bridges,
    diagnosis:
      portsLive.length === 0
        ? ["bridge-down"]
        : skew.stale.length
          ? ["version-skew"]
          : ["healthy"],
    fix: [],
  };
}

/**
 * Bulletproof path: setup files → diagnose → heal → optional reload → verify.
 */
async function runEnsure({
  asJson = false,
  forceReload = false,
  skipSetup = false,
} = {}) {
  const steps = [];
  if (!skipSetup) {
    try {
      steps.push("setup");
      runSetup();
    } catch (e) {
      steps.push("setup-failed:" + String(e.message || e));
    }
  }

  steps.push("doctor-before");
  const before = await runDoctorSilent();
  const skew = versionSkew(before.bridges || []);
  const needHeal =
    !before.portsListening173xx?.length ||
    forceReload ||
    skew.stale.length > 0;

  let recoverResult = null;
  if (needHeal) {
    const useReload = forceReload || skew.stale.length > 0;
    steps.push(useReload ? "recover-force-reload" : "recover-restart");
    recoverResult = await runRecover({
      asJson: true,
      forceReload: useReload,
      noExit: true,
      quiet: true,
    });
  } else {
    steps.push("already-healthy");
  }

  steps.push("doctor-after");
  const after = await runDoctorSilent();
  const skewAfter = versionSkew(after.bridges || []);
  const result = {
    ok:
      (after.portsListening173xx || []).length > 0 &&
      skewAfter.stale.length === 0,
    version: CLI_VERSION,
    steps,
    before: {
      ports: before.portsListening173xx,
      bridges: before.bridges,
      diagnosis: before.diagnosis,
    },
    recover: recoverResult
      ? {
          ok: recoverResult.ok,
          versionsOk: recoverResult.versionsOk,
          steps: recoverResult.steps,
          versionSkew: recoverResult.versionSkew,
        }
      : null,
    after: {
      ports: after.portsListening173xx,
      bridges: after.bridges,
      diagnosis: after.diagnosis,
    },
    selfHeal: {
      method: "ensure = setup + doctor + recover + verify",
    },
    next: !((after.portsListening173xx || []).length > 0)
      ? [
          "Open Cursor with a project folder",
          "Enable extension Cursor Browser CLI",
          "cursor-browser ensure --reload",
        ]
      : skewAfter.stale.length
        ? [
            "Hosts still on old code after reload attempt.",
            "Manually: Cmd+Shift+P → Developer: Reload Window in each project",
            "Then: cursor-browser doctor",
          ]
        : ["cursor-browser windows", "cursor-browser pin"],
  };
  print(result, { asJson });
  if (!result.ok) process.exit(2);
  return result;
}

function reexecSelfAfterRecover() {
  const { spawnSync } = require("child_process");
  const env = {
    ...process.env,
    CURSOR_BROWSER_RECOVERED: "1",
  };
  const r = spawnSync(process.execPath, process.argv.slice(1), {
    stdio: "inherit",
    env,
  });
  process.exit(r.status == null ? 1 : r.status);
}

/**
 * Last-resort: SIGTERM Cursor *user* extension-host
 * processes so Cursor respawns them and re-activates extensions from disk.
 * Only used when forceReload still sees version skew (pre-token hosts delete the
 * request-reload file after the first window handles it).
 */
function recycleUserExtensionHosts() {
  const killed = [];
  try {
    const out = execSync(
      'pgrep -fl "Cursor Helper \\(Plugin\\): extension-host \\(user\\)" 2>/dev/null || true',
      { encoding: "utf8" }
    );
    for (const line of out.split("\n")) {
      if (!line.trim()) continue;
      const pid = Number(line.trim().split(/\s+/)[0]);
      if (!pid || !Number.isFinite(pid)) continue;
      try {
        process.kill(pid, "SIGTERM");
        killed.push(pid);
      } catch {
        /* already gone */
      }
    }
  } catch {
    /* ignore */
  }
  return killed;
}

