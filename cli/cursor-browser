function parseArgs(argv) {
  const opts = { workspace: null, port: null, rest: [], flags: {} };
  for (let i = 0; i < argv.length; i++) {
    const a = argv[i];
    if (a === "--workspace" || a === "-w" || a === "--project") opts.workspace = argv[++i];
    else if (a === "--port" || a === "-p") opts.port = Number(argv[++i]);
    else if (a.startsWith("--workspace=")) opts.workspace = a.slice(12);
    else if (a === "--interactive") opts.flags.interactive = true;
    else if (a === "--json") opts.flags.json = true;
    else if (a === "--export") opts.flags.export = true;
    else if (a === "--snap" || a === "--snapshot") opts.flags.snap = true;
    else if (a === "--wait-nav" || a === "--wait-navigation") opts.flags.waitNav = true;
    else if (a === "--url") opts.flags.urlContains = argv[++i];
    else if (a === "--text") opts.flags.text = argv[++i];
    else if (a === "--ref") opts.flags.ref = argv[++i];
    else if (a === "--selector") opts.flags.selector = argv[++i];
    else if (a === "--timeout") opts.flags.timeoutMs = Number(argv[++i]);
    else if (a === "--y" || a === "--delta-y") opts.flags.y = Number(argv[++i]);
    else if (a === "--x" || a === "--delta-x") opts.flags.x = Number(argv[++i]);
    else if (a === "--top") opts.flags.top = Number(argv[++i]);
    else if (a === "--left") opts.flags.left = Number(argv[++i]);
    else if (a === "--value") opts.flags.value = argv[++i];
    else if (a === "--label") opts.flags.label = argv[++i];
    else if (a === "--index") opts.flags.index = Number(argv[++i]);
    else if (a === "-h" || a === "--help") opts.help = true;
    else opts.rest.push(a);
  }
  return opts;
}

function interactExtras(flags) {
  const extra = {};
  if (flags.snap) {
    extra.snapshot = true;
    extra.includeSnapshot = true;
  }
  if (flags.waitNav) {
    extra.waitNavigation = true;
    if (flags.timeoutMs) extra.timeoutMs = flags.timeoutMs;
  }
  return extra;
}

function looksLikeRef(s) {
  return /^e\d+$/i.test(s) || s === "root";
}

async function main() {
  const opts = parseArgs(process.argv.slice(2));
  if (opts.help || !opts.rest.length) {
    usage();
    process.exit(opts.help ? 0 : 1);
  }
  const [cmd, ...rest] = opts.rest;

  if (cmd === "setup" || cmd === "install") {
    try {
      runSetup();
    } catch (err) {
      console.error(err.message || err);
      process.exit(1);
    }
    return;
  }

  if (cmd === "doctor" || cmd === "diag" || cmd === "diagnose") {
    try {
      const report = await runDoctor({ asJson: !!opts.flags.json });
      process.exit(report.ok ? 0 : 2);
    } catch (err) {
      console.error(err.message || err);
      process.exit(1);
    }
    return;
  }

  if (cmd === "recover" || cmd === "restart" || cmd === "fix-bridge") {
    try {
      await runRecover({
        asJson: !!opts.flags.json,
        workspaceHint: opts.workspace || process.env.CURSOR_BROWSER_WORKSPACE || null,
      });
    } catch (err) {
      console.error(err.message || err);
      process.exit(1);
    }
    return;
  }

  if (cmd === "windows" || cmd === "list") {
    const instances = listInstances();
    const enriched = [];
    for (const inst of instances) {
      try {
        const r = await request("GET", "/whoami", null, inst.port);
        enriched.push({
          port: inst.port,
          primaryName: r.data.workspace?.primaryName || inst.primaryName,
          primaryPath: r.data.workspace?.primaryPath || inst.primaryPath,
          version: r.data.version,
          live: true,
        });
      } catch {
        enriched.push({
          port: inst.port,
          primaryName: inst.primaryName,
          live: false,
        });
      }
    }
    print({ ok: true, instances: enriched, cwd: process.cwd() });
    return;
  }

  let target;
  try {
    target = resolveTarget(opts);
  } catch (err) {
    console.error(err.message || err);
    process.exit(1);
  }
  const port = target.port;
  const action = (body) => request("POST", "/action", body, port);
  const get = (p) => request("GET", p, null, port);
  const extra = interactExtras(opts.flags);
  const asJson = !!opts.flags.json;

  try {
    let res;
    switch (cmd) {
      case "status":
      case "health":
        res = await get("/status");
        break;
      case "pin":
      case "resolve": {
        // Discover current project → port so agents can pin the correct bridge.
        const who = await get("/whoami");
        const pin = buildPinPayload(target, who.data || {});
        if (opts.flags.export) {
          pin._format = "export-shell";
        } else if (!asJson) {
          pin._format = "pin";
        }
        res = { data: pin, port, status: who.status };
        break;
      }
      case "whoami": {
        res = await get("/whoami");
        const pin = buildPinPayload(target, res.data || {});
        res.data = {
          ...res.data,
          routing: {
            how: target.how,
            score: target.score,
            cwd: process.cwd(),
            workspace: pin.workspace,
            port: pin.port,
          },
          pin: {
            workspace: pin.workspace,
            workspacePath: pin.workspacePath,
            port: pin.port,
            exports: pin.exports,
            use: pin.use,
            agent: pin.agent,
          },
        };
        break;
      }
      case "probe":
        res = await get("/probe");
        break;
      case "open":
        if (!rest[0]) throw new Error("url required");
        res = await action({
          action: "open",
          url: rest[0],
          interactive: true,
        });
        break;
      case "nav":
      case "navigate":
        if (!rest[0]) throw new Error("url required");
        res = await action({
          action: "navigate",
          url: rest[0],
          interactive: true,
        });
        break;
      case "tabs":
        res = await action({ action: "tabs" });
        break;
      case "close":
        res = await action({ action: "close", viewId: rest[0] });
        break;
      case "lock":
        res = await action({ action: "lock" });
        break;
      case "unlock":
        res = await action({ action: "unlock" });
        break;
      case "snap":
      case "snapshot":
      case "refs":
        res = await action({
          action: "snapshot",
          interactive: opts.flags.interactive !== false,
        });
        break;
      case "click":
      case "dblclick":
      case "doubleclick":
      case "double-click":
      case "rightclick":
      case "right-click":
      case "contextmenu": {
        if (!rest[0]) throw new Error("ref or selector required");
        const targetEl = rest[0];
        const kind =
          cmd === "click"
            ? "click"
            : cmd.startsWith("dbl") || cmd.startsWith("double")
              ? "dblclick"
              : "rightclick";
        res = await action(
          looksLikeRef(targetEl)
            ? { action: kind, ref: targetEl, ...extra }
            : { action: kind, selector: rest.join(" "), ...extra }
        );
        break;
      }
      case "type":
      case "fill": {
        if (rest.length < 2) throw new Error(`${cmd} <ref|selector> <text>`);
        const t = rest[0];
        const value = rest.slice(1).join(" ");
        res = await action(
          looksLikeRef(t)
            ? { action: cmd, ref: t, text: value, value, ...extra }
            : { action: cmd, selector: t, text: value, value, ...extra }
        );
        break;
      }
      case "select-option":
      case "select_option":
      case "option": {
        if (!rest[0]) throw new Error("select-option <ref|selector> <value|label>");
        const t = rest[0];
        const choice = rest.slice(1).join(" ") || opts.flags.value || opts.flags.label;
        const payload = {
          action: "select-option",
          ...(looksLikeRef(t) ? { ref: t } : { selector: t }),
          ...extra,
        };
        if (opts.flags.value != null) payload.value = opts.flags.value;
        else if (opts.flags.label != null) payload.label = opts.flags.label;
        else if (opts.flags.index != null) payload.index = opts.flags.index;
        else if (choice) {
          payload.value = choice;
          payload.label = choice;
        } else {
          throw new Error("select-option needs value, --label, or --index");
        }
        res = await action(payload);
        break;
      }
      case "scroll": {
        const t = rest[0];
        const payload = {
          action: "scroll",
          x: opts.flags.x || 0,
          y: opts.flags.y != null ? opts.flags.y : rest[1] != null ? Number(rest[1]) : undefined,
          top: opts.flags.top,
          left: opts.flags.left,
          ...extra,
        };
        if (t && looksLikeRef(t)) payload.ref = t;
        else if (t) payload.selector = t;
        res = await action(payload);
        break;
      }
      case "hover":
        if (!rest[0]) throw new Error("ref required");
        res = await action({ action: "hover", ref: rest[0], ...extra });
        break;
      case "press":
        if (!rest[0]) throw new Error("key required");
        res = await action({ action: "press", key: rest[0], ...extra });
        break;
      case "wait":
      case "wait-for":
        res = await action({
          action: "wait",
          urlContains: opts.flags.urlContains,
          text: opts.flags.text,
          ref: opts.flags.ref,
          selector: opts.flags.selector || rest[0],
          timeoutMs: opts.flags.timeoutMs || 30000,
        });
        break;
      case "resize":
        if (rest.length < 2) throw new Error("resize <width> <height>");
        res = await action({
          action: "resize",
          width: Number(rest[0]),
          height: Number(rest[1]),
        });
        break;
      case "url":
        res = await action({ action: "url" });
        break;
      case "title":
        res = await action({ action: "title" });
        break;
      case "inspect":
      case "dom":
        res = await action({ action: "inspect" });
        break;
      case "console":
      case "logs":
        res = await action({ action: "console" });
        break;
      case "network":
        res = await action({ action: "network" });
        break;
      case "eval":
      case "evaluate":
        if (!rest[0]) throw new Error("js required");
        res = await action({ action: "evaluate", script: rest.join(" ") });
        break;
      case "screenshot": {
        const outPath = rest[0] || path.join(os.tmpdir(), "cursor-browser.png");
        res = await action({ action: "screenshot", path: outPath });
        if (res.data?.ok !== false) {
          const r = res.data.result || res.data;
          const saved = saveScreenshot(r, outPath);
          if (res.data.result && typeof res.data.result === "object") {
            const slim = { ...res.data.result };
            delete slim.dataUrl;
            delete slim.data;
            res.data.result = slim;
          }
          res.data.savedTo = saved.path;
          res.data.bytes = saved.bytes;
        }
        break;
      }
      case "back":
        res = await action({ action: "back" });
        break;
      case "forward":
        res = await action({ action: "forward" });
        break;
      case "reload":
        res = await action({ action: "reload" });
        break;
      case "select":
      case "select-tab":
        if (!rest[0]) throw new Error("viewId required");
        res = await action({ action: "selectTab", viewId: rest[0] });
        break;
      default:
        usage();
        process.exit(1);
    }

    // If --snap was requested but post-action snapshot failed (common after navigation),
    // take a separate snapshot so agents still get fresh refs.
    if (
      opts.flags.snap &&
      res?.data?.ok !== false &&
      !extractSnapshotText(res.data) &&
      !["open", "nav", "navigate", "snap", "snapshot", "refs"].includes(cmd)
    ) {
      try {
        const snapRes = await action({
          action: "snapshot",
          interactive: true,
        });
        if (snapRes.data?.ok !== false && extractSnapshotText(snapRes.data)) {
          const base =
            res.data?.result && typeof res.data.result === "object"
              ? res.data.result
              : { action: res.data?.result };
          res.data = {
            ok: true,
            result: {
              ...base,
              snapshot: snapRes.data.result,
              snapshotVia: "cli-fallback",
            },
            _cli: res.data?._cli,
          };
        }
      } catch {
        /* keep original result */
      }
    }

    if (res.data && typeof res.data === "object") {
      const wsName =
        res.data.workspace?.primaryName ||
        res.data.pin?.workspace ||
        res.data.workspace ||
        target.instance?.primaryName ||
        target.workspace ||
        null;
      res.data._cli = {
        port,
        how: target.how,
        workspace: typeof wsName === "string" ? wsName : wsName?.primaryName || null,
      };
    }
    print(res.data !== undefined ? res.data : res, { asJson });
    if (res.data && res.data.ok === false) process.exit(2);
  } catch (err) {
    const msg = String(err.message || err);
    const isConn =
      /ECONNREFUSED|Cannot reach cursor-browser-cli|default-no-bridge/i.test(msg) ||
      target?.how === "default-no-bridge";
    if (isConn && !process.env.CURSOR_BROWSER_NO_AUTO_RECOVER) {
      console.error(msg);
      console.error("\n[cursor-browser] Attempting auto-recover...");
      try {
        await runRecover({
          asJson: !!opts.flags.json,
          workspaceHint: opts.workspace || null,
        });
        console.error("[cursor-browser] Recover reported live bridge. Re-run your command.");
        process.exit(3);
      } catch (recErr) {
        console.error(String(recErr.message || recErr));
        process.exit(1);
      }
    }
    console.error(msg);
    process.exit(1);
  }
}

main();
