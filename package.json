{
  "name": "cursor-browser-cli",
  "version": "1.0.0",
  "description": "CLI + MCP to drive Cursor IDE's built-in Browser Tab from Grok Build, Claude Code, Codex, or shell",
  "private": false,
  "license": "MIT",
  "author": "Brandon Charleson",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bcharleson/cursor-browser-cli.git"
  },
  "bugs": {
    "url": "https://github.com/bcharleson/cursor-browser-cli/issues"
  },
  "homepage": "https://github.com/bcharleson/cursor-browser-cli#readme",
  "keywords": [
    "cursor",
    "cursor-ide",
    "browser",
    "cli",
    "mcp",
    "claude-code",
    "codex",
    "grok",
    "browser-automation",
    "devtools"
  ],
  "bin": {
    "cursor-browser": "cli/cursor-browser",
    "cursor-browser-mcp": "mcp/server.mjs"
  },
  "files": [
    "cli/",
    "extension/",
    "mcp/",
    "scripts/setup.js",
    "scripts/install.sh",
    "skill/",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "setup": "node ./scripts/setup.js",
    "postinstall": "node ./scripts/setup.js",
    "install-cli": "node ./scripts/setup.js",
    "mcp": "node ./mcp/server.mjs",
    "prepublishOnly": "node -e \"require('fs').accessSync('cli/cursor-browser'); require('fs').accessSync('extension/extension.js'); require('fs').accessSync('mcp/server.mjs');\""
  },
  "engines": {
    "node": ">=18"
  }
}
